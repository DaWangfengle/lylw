STAGE_RECORD {"name": "post-run-independent-review", "command": ["D:\\miniminiconda\\envs\\liuyan\\python.exe", "-c", "import sys,json,hashlib,datetime\nfrom pathlib import Path\nimport numpy as np\nfrom fhm_dapp_tim.fhm_dapp import uji_v17_g12_action_ranking as g12\nroot=Path.cwd()\nev=g12.EVIDENCE\ndef sha(p):\n    h=hashlib.sha256()\n    with p.open(\"rb\") as f:\n        for b in iter(lambda:f.read(1048576),b\"\"):h.update(b)\n    return h.hexdigest()\nbaseline=json.loads((ev/\"RUN_STDOUT.log\").read_text(encoding=\"utf-8\").splitlines()[0].split(\" \",1)[1])\nfor name,expected in baseline[\"protected_files\"].items():\n    assert sha(root/name)==expected,(\"Protected historical file changed\",name)\nfor name,expected in baseline[\"original_models\"].items():\n    assert sha(root/name)==expected,(\"Original checkpoint changed\",name)\nmanifest=g12._read(g12.MANIFEST,\"manifest_sha256\")\nlock=g12._read(g12.LOCK)\nrecord=g12._read(g12.RESULT)\nassert record[\"manifest_file_sha256\"]==sha(g12.MANIFEST)==lock[\"manifest_file_sha256\"]\nassert record[\"lock_file_sha256\"]==sha(g12.LOCK) and record[\"lock_self_sha256\"]==lock[\"result_sha256\"]\nassert manifest[\"source_sha256\"]==g12._source_hashes()\nassert g12.REPORT.read_text(encoding=\"utf-8\")==g12._report(record)\n# Only now, after G12 result and lock are frozen, read historic score JSONs.\ng8= g12.g8._read(g12.g8.RESULT)\ng11path=root/\"fhm_dapp_tim/evidence/v17_g11_rss_identifiability/rss_identifiability_v17_g11.json\"\ng11=json.loads(g11path.read_text(encoding=\"utf-8\"))\nassert g11[\"result_sha256\"]==g12._canonical_json_sha256(g11,omit=\"result_sha256\")\ntotal_sites=total_rows=0\nroles={}\nfor domain in g12.DOMAINS:\n    seen_roles=[]\n    for role in g12.ROLES[domain]:\n        one=record[\"by_domain\"][domain][role]\n        keys=one[\"physical_coordinate_keys\"]\n        n=one[\"physical_sites\"]\n        total_sites+=n;total_rows+=one[\"rows\"]\n        assert n==len(keys)==len(set(map(tuple,keys)))\n        assert keys==[list(x) for x in sorted(map(tuple,keys))]\n        seen_roles.append(set(map(tuple,keys)))\n        old=g8[\"domains\"][domain][\"roles\"][role]\n        old11=g11[\"by_domain\"][domain][role]\n        assert keys==old[\"coordinate_keys\"]==old11[\"physical_coordinate_keys\"]\n        sv=one[\"site_vectors\"]\n        assert len(sv)==28\n        for col,values in sv.items():\n            assert len(values)==n\n            assert all(v is None or np.isfinite(v) for v in values)\n            valid=np.asarray([v for v in values if v is not None],dtype=np.float64)\n            st=one[\"summary\"][col]\n            assert st[\"n_sites\"]==n and st[\"n_finite_sites\"]==len(valid)\n            assert st[\"site_mean\"]==(float(valid.mean()) if len(valid) else None)\n            if not col.endswith(\"_best_near_rank\"):assert len(valid)==n\n            if col.endswith(\"_top1_in10m\") or col==\"near_reference_exists\":\n                assert ((valid>=0)&(valid<=1)).all()\n            if col.endswith(\"_near10_mass\"):assert ((valid>=0)&(valid<=1.000005)).all()\n            if col.endswith(\"_best_near_rank\"):\n                assert ((valid>=1)&(valid<=manifest[\"model_and_role_provenance\"][domain][\"anchors\"])).all() if \"anchors\" in manifest[\"model_and_role_provenance\"][domain] else ((valid>=1)&(valid<=945)).all()\n            if col.endswith(\"_mae_m\"):\n                assert (valid>=0).all()\n                expected={\"median_m\":float(np.median(valid)),\"p90_m\":float(np.quantile(valid,.9)),\n                    \"p95_m\":float(np.quantile(valid,.95)),\"p99_m\":float(np.quantile(valid,.99)),\n                    \"worst_5pct_mean_m\":float(np.sort(valid)[::-1][:max(1,int(np.ceil(.05*n)))].mean()),\n                    \"max_m\":float(valid.max()),\"sites_ge_10m\":int((valid>=10).sum()),\"sites_ge_20m\":int((valid>=20).sum())}\n                assert all(st[k]==v for k,v in expected.items()),(domain,role,col,\"tail mismatch\")\n        assert sv[\"mean_mae_m\"]==old[\"coordinate_vectors\"][\"anchor\"][\"mae\"],(domain,role,\"G8 exact MAE mismatch\")\n        assert sv[\"shared_student_t_es_m\"]==old[\"coordinate_vectors\"][\"anchor\"][\"es\"],(domain,role,\"G8 exact ES mismatch\")\n        assert sv[\"prototype_only_top1_in10m\"]==old11[\"site_vectors\"][\"raw_l2_top1_in_10m\"],(domain,role,\"G11 prototype Top1 mismatch\")\n        assert sv[\"R3_consensus_K192_top1_in10m\"]==old11[\"site_vectors\"][\"v17_top1_in_10m\"],(domain,role,\"G11 consensus Top1 mismatch\")\n        for action in (\"component_median\",\"continuous_median\"):\n            d=(np.asarray(sv[action+\"_mae_m\"])-np.asarray(sv[\"mean_mae_m\"]))\n            p=one[\"decision_effects\"][action+\"_minus_mean\"]\n            assert p[\"coordinate_vector_delta_mae_m\"]==d.tolist()\n            assert p[\"mean_delta_mae_m\"]==float(d.mean())\n            assert p[\"improved_sites\"]==int((d<0).sum()) and p[\"worsened_sites\"]==int((d>0).sum())\n            assert p[\"worst_harm_m\"]==float(d.max()) and p[\"best_gain_m\"]==-float(d.min())\n            rd=np.asarray(sv[action+\"_model_risk_m\"])-np.asarray(sv[\"mean_model_risk_m\"])\n            z=one[\"risk_vs_realized_error_posthoc\"][action]\n            assert z[\"model_risk_delta_by_site_m\"]==rd.tolist()\n            assert z[\"mean_model_risk_delta_m\"]==float(rd.mean())\n            assert z[\"mean_realized_mae_delta_m\"]==float(d.mean())\n            assert z[\"model_risk_improved_sites\"]==int((rd<0).sum())\n            assert z[\"model_risk_improved_but_real_mae_worse_sites\"]==int(((rd<0)&(d>0)).sum())\n            assert z[\"model_risk_worse_but_real_mae_better_sites\"]==int(((rd>0)&(d<0)).sum())\n        for before,after in zip(g12.STAGES[:-1],g12.STAGES[1:]):\n            b=np.asarray(sv[before+\"_top1_in10m\"])>=.5\n            a=np.asarray(sv[after+\"_top1_in10m\"])>=.5\n            t=one[\"ranking_stage_transitions_posthoc\"][before+\"__to__\"+after]\n            assert t=={\"both_correct\":int((b&a).sum()),\"lost_correct\":int((b&~a).sum()),\"rescued_correct\":int((~b&a).sum()),\"both_wrong\":int((~b&~a).sum())}\n        special={}\n        if domain==\"tampere\":\n            for idx,key in enumerate(keys):\n                if abs(key[2]-262.94)<.011 and min(abs(key[3]-107.04),abs(key[3]-112.04))<.011:\n                    special[str(key)]={name:sv[name][idx] for name in sv}\n            assert len(special)==2,\"Predeclared Tampere extreme coordinates not found\"\n        raw_only=[]\n        if domain==\"uts\":\n            for idx,key in enumerate(keys):\n                if sv[\"prototype_only_top1_in10m\"][idx]>=.5 and sv[\"R3_consensus_K192_top1_in10m\"][idx]<.5:\n                    raw_only.append({\"key\":key,\n                        \"stage_top1_fraction\":{s:sv[s+\"_top1_in10m\"][idx] for s in g12.STAGES},\n                        \"mean_mae_m\":sv[\"mean_mae_m\"][idx],\n                        \"component_median_mae_m\":sv[\"component_median_mae_m\"][idx],\n                        \"continuous_median_mae_m\":sv[\"continuous_median_mae_m\"][idx]})\n            assert len(raw_only)==16\n        roles[domain+\"/\"+role]={\"physical_sites\":n,\"rows\":one[\"rows\"],\n            \"keys_sha256\":g12._canonical_json_sha256(keys),\n            \"G8_exact_MAE_and_ES\":True,\"G11_exact_raw_and_consensus_Top1\":True,\n            \"actions\":{a:one[\"summary\"][a+\"_mae_m\"] for a in g12.ACTIONS},\n            \"risk\":{a:one[\"summary\"][a+\"_model_risk_m\"][\"site_mean\"] for a in g12.ACTIONS},\n            \"shared_es_m\":one[\"summary\"][\"shared_student_t_es_m\"][\"site_mean\"],\n            \"decision_effects\":{a:{k:v for k,v in one[\"decision_effects\"][a+\"_minus_mean\"].items() if not k.startswith(\"coordinate_vector\")} for a in (\"component_median\",\"continuous_median\")},\n            \"risk_error_alignment\":{a:{k:v for k,v in one[\"risk_vs_realized_error_posthoc\"][a].items() if not k.startswith(\"model_risk_delta_by\")} for a in (\"component_median\",\"continuous_median\")},\n            \"action_shift_m\":{a:one[\"summary\"][\"action_shift_\"+a+\"_m\"][\"site_mean\"] for a in (\"component\",\"continuous\")},\n            \"top1_macro\":{s:one[\"summary\"][s+\"_top1_in10m\"][\"site_mean\"] for s in g12.STAGES},\n            \"transitions\":one[\"ranking_stage_transitions_posthoc\"],\n            \"uts_raw_only_sites\":raw_only,\"tampere_declared_extreme_sites\":special}\n    assert all(not l&r for i,l in enumerate(seen_roles) for r in seen_roles[i+1:])\nassert (total_sites,total_rows)==(909,4825)\nlog_text=(ev/\"RUN_STDOUT.log\").read_text(encoding=\"utf-8\")\nstages=[json.loads(line.split(\" \",1)[1]) for line in log_text.splitlines() if line.startswith(\"STAGE_RECORD \")]\nassert sum(s[\"name\"]==\"run-once\" for s in stages)==1\nassert next(s for s in stages if s[\"name\"]==\"run-once\")[\"exit_code\"]==0\ninput_paths=[root/\"data/UTSIndoorLoc/UTS_training.csv\",root/\"data/Tampere/Training_rss.csv\",root/\"data/Tampere/Training_coordinates.csv\"]\ninput_paths += [root/f\"data/TUJI1/Formatted_data_{d}.mat\" for d in (\"A12\",\"POCO\",\"S20\",\"S7\",\"tabS7\")]\nreview={\"status\":\"POST_RUN_INDEPENDENT_REVIEW_PASSED\",\"roles\":roles,\n    \"total_sites\":total_sites,\"total_rows\":total_rows,\"vectors_rechecked\":28*5,\n    \"protected_unchanged_count\":len(baseline[\"protected_files\"]),\n    \"protected_inventory_sha256\":g12._canonical_json_sha256(baseline[\"protected_files\"]),\n    \"original_checkpoints_unchanged_count\":len(baseline[\"original_models\"]),\n    \"input_file_sha256\":{p.relative_to(root).as_posix():sha(p) for p in input_paths},\n    \"artifact_file_sha256\":{p.name:sha(p) for p in (g12.MANIFEST,g12.LOCK,g12.RESULT,g12.REPORT)},\n    \"source_sha256\":manifest[\"source_sha256\"],\n    \"G8_file_sha256\":sha(g12.g8.RESULT),\"G11_file_sha256\":sha(g11path),\n    \"no_new_inference_or_selection\":True,\n    \"post_run_review_at\":datetime.datetime.now(datetime.timezone(datetime.timedelta(hours=8))).isoformat()}\nprint(json.dumps(review,ensure_ascii=False,allow_nan=False))\n"], "started_at": "2026-10-10T17:05:40.252359+08:00", "duration_seconds": 8.000463100004708, "exit_code": 0, "stdout_sha256": "28ee5f61cc80e1a2848c5b274b24d65c06cbf54c9d3edff3200f6e108450ef91", "stderr_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "stdout_bytes": 32564, "stderr_bytes": 0}
