STAGE_RECORD {"name": "fit-only-cuda-and-identity-smoke", "command": ["D:\\miniminiconda\\envs\\liuyan\\python.exe", "-c", "import sys,json,hashlib,inspect,gc\nfrom pathlib import Path\nimport numpy as np,torch\nroot=Path.cwd()\nev=root/\"fhm_dapp_tim/evidence/v17_g12_action_ranking\"\nassert not (ev/\"manifest_v17_g12.json\").exists() and not (ev/\"run_v17_g12.lock\").exists()\nallowed={(root/\"data/UTSIndoorLoc/UTS_training.csv\").resolve(),\n         (root/\"data/Tampere/Training_rss.csv\").resolve(),\n         (root/\"data/Tampere/Training_coordinates.csv\").resolve()}\nallowed.update((root/f\"data/TUJI1/Formatted_data_{x}.mat\").resolve() for x in (\"A12\",\"POCO\",\"S20\",\"S7\",\"tabS7\"))\nopened=set()\ndata_root=(root/\"data\").resolve()\ndef open_guard(event,args):\n    if event!=\"open\" or not isinstance(args[0],(str,bytes,Path)):return\n    p=Path(args[0]).resolve()\n    if data_root==p or data_root in p.parents:\n        if p not in allowed:raise AssertionError(f\"Forbidden data access: {p}\")\n        opened.add(p)\nsys.addaudithook(open_guard)\nfrom fhm_dapp_tim.fhm_dapp import uji_v17_g12_action_ranking as g12\nfrom fhm_dapp_tim.fhm_dapp import uji_v17_g11_rss_identifiability as g11\ng8=g12.g8\ng6=g8.g6\nmat_calls=[]\noriginal_loadmat=g6.loadmat\ndef restricted_loadmat(path,*args,**kw):\n    assert tuple(kw.get(\"variable_names\",()))==(\"results_train\",)\n    value=original_loadmat(path,*args,**kw)\n    assert \"results_test\" not in value\n    mat_calls.append({\"path\":str(path),\"variable_names\":list(kw[\"variable_names\"]),\"results_test_returned\":False})\n    return value\ng6.loadmat=restricted_loadmat\ndef prohibit_optimization(*args,**kwargs):raise AssertionError(\"Optimizer creation prohibited in G12\")\ntorch.optim.Optimizer.__init__=prohibit_optimization\ndef sha(p):return hashlib.sha256(p.read_bytes()).hexdigest()\nsummary={}\neval_sites=eval_rows=0\nfor domain in g12.DOMAINS:\n    pack=g8._pack(domain)\n    data,rows,groups=pack[\"data\"],pack[\"rows\"],pack[\"groups\"]\n    for left in groups:\n        for right in groups:\n            if left<right:assert not groups[left]&groups[right],(domain,left,right,\"physical overlap\")\n    models,origin=g8._load_models(domain,{\"model_and_role_provenance\":{domain:pack[\"original\"]}},\"cuda\")\n    assert len(models)==5 and int(models[0].n_anchors)>=192\n    states=[{k:v.detach().cpu().clone() for k,v in m.state_dict().items()} for m in models]\n    ref=models[0]\n    assert np.isfinite(origin).all()\n    for idx,m in enumerate(models,1):\n        assert not m.training\n        assert all(p.grad is None for p in m.parameters())\n        for name in (\"anchor_coords\",\"anchor_buildings\",\"anchor_floors\",\"anchor_rss\"):\n            assert torch.equal(getattr(ref,name),getattr(m,name)),(domain,name,idx)\n        assert torch.equal(ref.encoder.seen_ap_mask,m.encoder.seen_ap_mask)\n    fit_anchor=g11.map_fit_rows_to_model_anchors(data,rows[\"fit\"],ref,origin)\n    keys=set(data[\"keys\"][int(i)] for i in rows[\"fit\"])\n    mapped={}\n    for row,id_ in zip(rows[\"fit\"],fit_anchor.tolist()):\n        key=data[\"keys\"][int(row)]\n        assert key not in mapped or mapped[key]==id_\n        mapped[key]=id_\n    assert len(keys)==len(mapped)==len(set(mapped.values()))==int(ref.n_anchors)\n    role_info={}\n    for role in g12.ROLES[domain]:\n        expected=sorted(groups[role])\n        assert sorted(set(data[\"keys\"][int(i)] for i in rows[role]))==expected\n        role_info[role]={\"physical_sites\":len(expected),\"rows\":len(rows[role]),\n                        \"keys_sha256\":g12._canonical_json_sha256([list(x) for x in expected])}\n        eval_sites+=len(expected);eval_rows+=len(rows[role])\n    # Only original FIT samples are used in this CUDA compatibility smoke.\n    smoke_rows=rows[\"fit\"][:16]\n    torch.cuda.reset_peak_memory_stats()\n    out=g12.score_role(models,data,smoke_rows,origin)\n    assert out[\"rows\"]==16 and out[\"random_streams_independent\"]\n    for name,vector in out[\"site_vectors\"].items():\n        assert len(vector)==out[\"physical_sites\"]\n        assert all(v is None or np.isfinite(v) for v in vector)\n        if not name.endswith(\"_best_near_rank\"):assert all(v is not None for v in vector)\n    for m,before in zip(models,states):\n        assert all(torch.equal(v.detach().cpu(),before[k]) for k,v in m.state_dict().items())\n        assert all(p.grad is None for p in m.parameters())\n    summary[domain]={\"fit_sites\":len(keys),\"fit_rows\":len(rows[\"fit\"]),\"roles\":role_info,\n                    \"fit_anchor_bijection\":True,\"shared_fit_dictionary\":True,\n                    \"cuda_fit_smoke_rows\":16,\"finite_smoke\":True,\n                    \"all_model_state_bitwise_unchanged\":True,\"all_parameter_grad_none\":True,\n                    \"cuda_peak_allocated_bytes\":torch.cuda.max_memory_allocated()}\n    del models,states,out,ref,pack,data\n    gc.collect();torch.cuda.empty_cache()\nassert (eval_sites,eval_rows)==(909,4825)\nassert len(mat_calls)==5 and opened==allowed\naction_rng=g12.common_student_t_randomness(2,draws=128,degrees_freedom=4,seed=19801)\nrisk_rng=g12.common_student_t_randomness(2,draws=128,degrees_freedom=4,seed=19802)\nassert not torch.equal(action_rng[\"uniform_1\"],risk_rng[\"uniform_1\"])\nassert not torch.equal(action_rng[\"noise_1\"],risk_rng[\"noise_1\"])\nassert not torch.equal(action_rng[\"uniform_1\"],action_rng[\"uniform_2\"])\nprint(json.dumps({\"status\":\"FIT_ONLY_CUDA_AND_IDENTITY_SMOKE_PASSED\",\"domains\":summary,\n    \"total_historical_scoring_sites\":eval_sites,\"total_historical_scoring_rows\":eval_rows,\n    \"allowed_train_files_opened\":[p.relative_to(root).as_posix() for p in sorted(opened)],\n    \"restricted_mat_calls\":mat_calls,\"optimizer_creation_prohibited\":True,\n    \"action_risk_streams_distinct\":True,\"no_old_scoring_results_read\":True},ensure_ascii=False,allow_nan=False))\n"], "started_at": "2026-10-