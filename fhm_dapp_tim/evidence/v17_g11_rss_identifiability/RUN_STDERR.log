STAGE_RECORD {"stage": "map-distance-independent-fit-proof", "started": "2026-10-10T16:01:37.343342+08:00", "duration_seconds": 9.488546199980192, "exit_code": 0, "args": ["-c", "\nimport json\nimport numpy as np, torch\nfrom fhm_dapp_tim.fhm_dapp import uji_v17_g11_rss_identifiability as g11\nassert not g11.MANIFEST.exists() and not g11.LOCK.exists()\nout={}\nfor domain in g11.DOMAINS:\n    data=g11.g8._pack(domain)\n    models,origin=g11.g8._load_models(domain,{\"model_and_role_provenance\":{domain:data[\"original\"]}},\"cpu\")\n    ref=models[0]\n    rows=data[\"rows\"][\"fit\"]\n    _,keys=g11.r2b._coordinate_groups([data[\"data\"][\"keys\"][int(i)] for i in rows])\n    expected=torch.tensor([[k[2],k[3]] for k in keys],dtype=torch.float32)-torch.as_tensor(origin,dtype=torch.float32)\n    actual=ref.anchor_coords.detach().cpu().float()\n    same=(torch.tensor([k[0] for k in keys])[:,None]==ref.anchor_buildings[None,:])&(torch.tensor([k[1] for k in keys])[:,None]==ref.anchor_floors[None,:])\n    d_default=torch.cdist(expected,actual).masked_fill(~same,float(\"inf\"))\n    d_direct=torch.cdist(expected.double(),actual.double(),compute_mode=\"donot_use_mm_for_euclid_dist\").masked_fill(~same,float(\"inf\"))\n    id32=d_default.argmin(1);id64=d_direct.argmin(1)\n    err32=d_default.gather(1,id32[:,None]).squeeze(1)\n    err64=d_direct.gather(1,id64[:,None]).squeeze(1)\n    out[domain]={\"anchors\":len(keys),\"default_float32_max_m\":float(err32.max()),\"direct_float64_max_m\":float(err64.max()),\"default_over_03m\":int((err32>.03).sum()),\"direct_over_03m\":int((err64>.03).sum()),\"id_disagreements\":int((id32!=id64).sum()),\"direct_unique_matches\":int(id64.unique().numel()),\"unique_float32\":int(id32.unique().numel())}\n    assert id64.unique().numel()==len(keys) and err64.max()<=.03\nprint(json.dumps(out,indent=2))\n"], "stdout_sha256": "38757fac865f1dddf2f3356cd32700dbae5ee35b1b1f583cddb1f9837c461826", "stderr_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e464