STAGE_RECORD {"stage": "identity-fit-map-ap-formula-cuda-smoke", "started": "2026-10-10T16:00:30.949505+08:00", "duration_seconds": 4.0915129000204615, "exit_code": 1, "args": ["-c", "\nimport sys, os, json, hashlib\nfrom pathlib import Path\nfrom itertools import combinations\nimport numpy as np, torch\nfrom fhm_dapp_tim.fhm_dapp import uji_v17_g11_rss_identifiability as g11\nfrom fhm_dapp_tim.fhm_dapp.anchor import build_anchor_memory\nroot=Path.cwd()\nassert not g11.MANIFEST.exists() and not g11.LOCK.exists()\nallowed=[root/\"data/UTSIndoorLoc/UTS_training.csv\",root/\"data/Tampere/Training_rss.csv\",root/\"data/Tampere/Training_coordinates.csv\"]\nallowed += [root/(\"data/TUJI1/Formatted_data_\"+d+\".mat\") for d in (\"A12\",\"POCO\",\"S20\",\"S7\",\"tabS7\")]\nallowed={os.path.normcase(str(p.resolve())) for p in allowed}\nopened=set(); blocked=[]\ndef guard(event,args):\n    if event!=\"open\" or not isinstance(args[0],(str,bytes,os.PathLike)): return\n    p=os.path.normcase(os.path.abspath(os.fsdecode(args[0])))\n    if p.startswith(os.path.normcase(str(root/\"data\"))+os.sep):\n        if p not in allowed:\n            blocked.append(p);raise RuntimeError(\"Forbidden dataset open: \"+p)\n        opened.add(p)\nsys.addaudithook(guard)\nmat_calls=[]\noriginal_loadmat=g11.g8.g6.scipy_io.loadmat\ndef limited_mat(path,*args,**kwargs):\n    assert tuple(kwargs.get(\"variable_names\",()))==(\"results_train\",)\n    result=original_loadmat(path,*args,**kwargs)\n    assert \"results_test\" not in result\n    mat_calls.append({\"file\":Path(path).name,\"requested\":[\"results_train\"],\"results_test_returned\":False})\n    return result\ng11.g8.g6.scipy_io.loadmat=limited_mat\n# An independently built synthetic original R0 memory tests the AP formula.\nrss=torch.tensor([[-1.,.2,-.999],[-1.,.8,-.998],[.4,-1.,.2]],dtype=torch.float32)\ncoords=np.array([[5.,0.],[5.,0.],[15.,0.]],dtype=np.float32)\nb=np.zeros(3,dtype=np.int64);f=np.ones(3,dtype=np.int64)\nmemory,ids=build_anchor_memory(rss,coords,b,f,np.arange(3))\nseen=torch.tensor([True,True,True])\nfreq=g11.fit_site_ap_frequency(rss,torch.tensor(ids),2,seen)\nassert torch.equal(freq,memory[\"detection_prob\"])\ntoy_query=torch.tensor([[-1.,.2,-.998],[.4,-1.,-1.]],dtype=torch.float32)\ndirect=((toy_query>-.999).float()[:,None,:]-freq[None,:,:]).square().mean(2)\nassert torch.allclose(g11.visibility_brier_distance(toy_query,freq),direct,atol=1e-7,rtol=1e-6)\ninfo={\"synthetic_original_r0_ap_formula_exact\":True,\"synthetic_brier_direct_checked\":True,\"domains\":{}}\nfor domain in g11.DOMAINS:\n    data=g11.g8._pack(domain)\n    models,origin=g11.g8._load_models(domain,{\"model_and_role_provenance\":{domain:data[\"original\"]}},\"cuda\")\n    ref=models[0]\n    assert len(models)==5\n    state=[{k:v.detach().cpu().clone() for k,v in m.state_dict().items()} for m in models]\n    for m in models:\n        assert not m.training and not m.use_candidate_reranker\n        for attr in (\"anchor_coords\",\"anchor_buildings\",\"anchor_floors\",\"prototype_rss\"):\n            assert torch.equal(getattr(m,attr).detach().cpu(),getattr(ref,attr).detach().cpu())\n        assert torch.equal(m.encoder.seen_ap_mask.detach().cpu(),ref.encoder.seen_ap_mask.detach().cpu())\n    groups=data[\"groups\"]\n    for x,y in combinations(groups,2): assert not groups[x]&groups[y]\n    rows=data[\"rows\"][\"fit\"]\n    gid,keys=g11.map_fit_rows_to_model_anchors(rows,data[\"data\"],ref,origin)\n    sorted_coords=np.array([[k[2],k[3]] for k in keys],dtype=np.float64)-np.asarray(origin,dtype=np.float64)\n    ref_coords=ref.anchor_coords.detach().cpu().numpy().astype(np.float64)\n    key_dist=np.linalg.norm(sorted_coords[:,None,:]-ref_coords[None,:,:],axis=2)\n    key_b=np.array([k[0] for k in keys]);key_f=np.array([k[1] for k in keys])\n    key_dist[(key_b[:,None]!=ref.anchor_buildings.detach().cpu().numpy()[None,:])|(key_f[:,None]!=ref.anchor_floors.detach().cpu().numpy()[None,:])]=np.inf\n    key_anchor=np.argmin(key_dist,axis=1)\n    assert len(np.unique(key_anchor))==len(keys)\n    errors=key_dist[np.arange(len(keys)),key_anchor]\n    assert errors.max()<=.03\n    original_gid,original_keys=g11.r2b._coordinate_groups([data[\"data\"][\"keys\"][int(i)] for i in rows])\n    assert list(keys)==list(original_keys)\n    assert np.array_equal(gid.numpy(),key_anchor[original_gid.numpy()])\n    fit_rss=data[\"data\"][\"rss\"][rows].detach().cpu().float()\n    mask=ref.encoder.seen_ap_mask.detach().cpu().bool()\n    actual_freq=g11.fit_site_ap_frequency(fit_rss,gid,int(ref.n_anchors),mask)\n    # Rebuild the original R0 FIT-only memory; compare with global checkpoint IDs.\n    fit_xy=(data[\"data\"][\"raw_xy\"][rows]-np.asarray(origin)[None,:]).astype(np.float32)\n    original_memory,original_ids=build_anchor_memory(fit_rss,fit_xy,data[\"data\"][\"building\"][rows],data[\"data\"][\"floor\"][rows],np.arange(len(rows)))\n    for aid in range(int(ref.n_anchors)):\n        scan_ids=np.flatnonzero(gid.numpy()==aid)\n        mapped=np.unique(original_ids[scan_ids]);assert len(mapped)==1\n        oid=int(mapped[0])\n        assert torch.equal(actual_freq[aid],original_memory[\"detection_prob\"][oid,mask])\n        assert torch.equal(ref.prototype_rss.detach().cpu()[aid],original_memory[\"prototype_rss\"][oid])\n    # FIT-only two-query smoke; the actual G11 target roles are not scored.\n    torch.cuda.reset_peak_memory_stats()\n    out=g11.score_role(models,data[\"data\"],rows[:2],origin,actual_freq)\n    assert out[\"rows\"]==2\n    for key in g11.METRICS:\n        assert np.isfinite(out[\"summary\"][key+\"_point_mae_m\"][\"macro_mean\"])\n    for m,old in zip(models,state):\n        assert all(torch.equal(v.detach().cpu(),old[k]) for k,v in m.state_dict().items())\n        assert all(p.grad is None for p in m.parameters())\n    entry={\"roles\":{role:{\"sites\":len(groups[role]),\"rows\":len(data[\"rows\"][role])} for role in groups},\n           \"fit_anchor_bijection\":True,\"fit_mapping_max_error_m\":float(errors.max()),\"non_identity_fit_to_global_ids\":int(np.count_nonzero(key_anchor!=np.arange(len(key_anchor)))),\n           \"ap_frequency_exact_original_fit_memory\":True,\"prototype_rss_exact_original_fit_memory\":True,\"model_seen_aps\":int(mask.sum()),\"fit_only_cuda_smoke\":True,\n           \"all_network_state_bitwise_unchanged\":True,\"all_network_grad_none\":True,\"cuda_peak_allocated_bytes\":torch.cuda.max_memory_allocated(),\n           \"checkpoint_sha256\":data[\"original\"][\"checkpoints\"]}\n    info[\"domains\"][domain]=entry\n    del models,state,ref\n    torch.cuda.empty_cache()\ninfo[\"opened_training_containers\"]=sorted(opened)\ninfo[\"mat_variable_restriction_calls\"]=mat_calls\ninfo[\"blocked_forbidden_opens\"]=blocked\nassert not blocked and len(opened)==8 and len(mat_calls)==5\nprint(json.dumps(info,ensure_ascii=False,indent=2))\n"], "stdout_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "stderr_sha256": "c084e1f18d90add279485de9dab051cb5e122d7c917d97be41515a9200d5734c"}
