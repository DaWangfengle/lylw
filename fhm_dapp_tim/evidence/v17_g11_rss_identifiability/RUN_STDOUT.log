mory(rss,coords,b,f,np.arange(3))\nseen=torch.tensor([True,True,True])\nfreq=g11.fit_site_ap_frequency(rss,torch.tensor(ids),2,seen)\nassert torch.equal(freq,memory[\"detection_prob\"])\ntoy_query=torch.tensor([[-1.,.2,-.998],[.4,-1.,-1.]],dtype=torch.float32)\ndirect=((toy_query>-.999).float()[:,None,:]-freq[None,:,:]).square().mean(2)\nassert torch.allclose(g11.visibility_brier_distance(toy_query,freq),direct,atol=1e-7,rtol=1e-6)\ninfo={\"synthetic_original_r0_ap_formula_exact\":True,\"synthetic_brier_direct_checked\":True,\"domains\":{}}\nfor domain in g11.DOMAINS:\n    data=g11.g8._pack(domain)\n    models,origin=g11.g8._load_models(domain,{\"model_and_role_provenance\":{domain:data[\"original\"]}},\"cuda\")\n    ref=models[0]\n    assert len(models)==5\n    state=[{k:v.detach().cpu().clone() for k,v in m.state_dict().items()} for m in models]\n    for m in models:\n        assert not m.training and not m.use_candidate_reranker\n        for attr in (\"anchor_coords\",\"anchor_buildings\",\"anchor_floors\",\"prototype_rss\"):\n            assert torch.equal(getattr(m,attr).detach().cpu(),getattr(ref,attr).detach().cpu())\n        assert torch.equal(m.encoder.seen_ap_mask.detach().cpu(),ref.encoder.seen_ap_mask.detach().cpu())\n    groups=data[\"groups\"]\n    for x,y in combinations(groups,2): assert not groups[x]&groups[y]\n    rows=data[\"rows\"][\"fit\"]\n    gid,keys=g11.map_fit_rows_to_model_anchors(rows,data[\"data\"],ref,origin)\n    sorted_coords=np.array([[k[2],k[3]] for k in keys],dtype=np.float64)-np.asarray(origin,dtype=np.float64)\n    ref_coords=ref.anchor_coords.detach().cpu().numpy().astype(np.float64)\n    key_dist=np.linalg.norm(sorted_coords[:,None,:]-ref_coords[None,:,:],axis=2)\n    key_b=np.array([k[0] for k in keys]);key_f=np.array([k[1] for k in keys])\n    key_dist[(key_b[:,None]!=ref.anchor_buildings.detach().cpu().numpy()[None,:])|(key_f[:,None]!=ref.anchor_floors.detach().cpu().numpy()[None,:])]=np.inf\n    key_anchor=np.argmin(key_dis