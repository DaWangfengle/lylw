import json,sys,itertools
from pathlib import Path
import numpy as np,torch
from fhm_dapp_tim.fhm_dapp import uji_v17_g8_hierarchical_attribution as g8
allowed={str((Path.cwd()/p).resolve()).casefold() for p in (\"data/UTSIndoorLoc/UTS_training.csv\",\"data/Tampere/Training_rss.csv\",\"data/Tampere/Training_coordinates.csv\")}
allowed.update(str((g8.g6.MAT_DIR/name).resolve()).casefold() for name in g8.g6.ds.TUJI_DEVICE_FILES.values())
opened=set()
def access_guard(event,args):
    if event==\"open\" and args and isinstance(args[0],(str,bytes,Path)):
        value=Path(args[0].decode() if isinstance(args[0],bytes) else args[0]).resolve()
        token=str(value).casefold()
        if \"data\" in [part.casefold() for part in value.parts] and str(Path.cwd()).casefold() in token:
            if token not in allowed:raise RuntimeError(f\"Forbidden raw data access: {value}\")
            opened.add(token)
sys.addaudithook(access_guard)
mat_calls=[]
original_loadmat=g8.g6.loadmat
def train_only_mat(*args,**kwargs):
    assert kwargs.get(\"variable_names\")==(\"results_train\",)
    obj=original_loadmat(*args,**kwargs)
    assert \"results_test\" not in obj
    mat_calls.append({\"file\":Path(args[0]).name,\"variables\":list(kwargs[\"variable_names\"]),\"results_test_returned\":False})
    return obj
g8.g6.loadmat=train_only_mat
panels={}
for domain in g8.DOMAINS:
    pack=g8._pack(domain)
    assert all(not(pack[\"groups\"][a]&pack[\"groups\"][b]) for a,b in itertools.combinations(pack[\"groups\"],2))
    manifest={\"model_and_role_provenance\":{domain:pack[\"original\"]}}
    models,origin=g8._load_models(domain,manifest,\"cpu\")
    module={\"tuji\":g8.g6,\"uts\":g8.g4,\"tampere\":g8.g5}[domain]
    ref=models[0];members=[]
    for i,model in enumerate(models,1):
        ck=torch.load(module.member_path(i),map_location=\"cpu\",weights_only=True)
        assert ck[\"member_seed\"]==module.SEEDS[i-1] and ck[\"epoch\"]==module.EPOCHS[i-1] and ck[\"member_index\"]==i
        for name in (\"anchor_coords\",\"anchor_buildings\",\"anchor_floors\",\"prototype_rss\"):
            assert torch.equal(getattr(model,name),getattr(ref,name))
        assert torch.equal(model.encoder.seen_ap_mask,ref.encoder.seen_ap_mask)
        assert all(p.grad is None for p in model.parameters()) and not model.training
        assert int(model.n_anchors)==len(pack[\"groups\"][\"fit\"])
        assert float(model.student_df)==4.0 and model.residual_experts==1 and not model.use_candidate_reranker
        members.append({\"index\":i,\"seed\":ck[\"member_seed\"],\"epoch\":ck[\"epoch\"],\"sha256\":pack[\"original\"][\"checkpoints\"][i-1]})
    panels[domain]={\"members\":members,\"origin\":origin.tolist(),\"anchors\":int(ref.n_anchors),\"no_role_overlap\":True}
    del models
assert torch.cuda.is_available()
torch.manual_seed(19708)
device=torch.device(\"cuda\")
w=torch.softmax(torch.randn(2,5,device=device),-1)
c=torch.softmax(torch.randn(2,192,device=device),-1)
p=(w[:,:,None]*c[:,None,:]).reshape(2,960)
loc=torch.randn(2,960,2,device=device)*10
sigma=0.2+torch.rand_like(loc)
weights=g8.hierarchical_laws(p)
rnd=g8.common_student_t_randomness(2,draws=64,degrees_freedom=4.,seed=19602)
random=g8.g6._random_slice(rnd,0,2,device)
checks={}
with torch.no_grad(),g8.r3.r2f_a1._deterministic_algorithms():
    for name,q in weights.items():
        es,mae=g8.r3._score_joint_law(q,loc,sigma,torch.zeros(2,2,dtype=torch.float64,device=device),random)
        assert torch.isfinite(es).all() and torch.isfinite(mae).all()
        d=g8.decompose_trace(q,loc,sigma)
        checks[name]={
            \"anchor_first_abs_residual_m2\":float((d[\"between_centres_trace_m2\"]-d[\"anchor_between_given_member_average_m2\"]-d[\"member_within_anchor_m2\"]).abs().max()),
            \"member_first_abs_residual_m2\":float((d[\"between_centres_trace_m2\"]-d[\"member_between_given_anchor_average_m2\"]-d[\"anchor_within_member_m2\"]).abs().max())}
print(json.dumps({\"status\":\"ORIGINAL_15_MODELS_AND_SYNTHETIC_CUDA_CHECKED\",\"panels\":panels,\"mat_loadmat_calls\":mat_calls,\"allowed_training_sources_opened\":sorted(opened),\"cuda_device\":torch.cuda.get_device_name(0),\"synthetic_E5_K192_two_streams_64\":True,\"variance_residual_m2\":checks,\"calibration_or_confirmation_scored\":False,\"gpu_peak_allocated_bytes\":torch.cuda.max_memory_allocated()},ensure_ascii=False))
"


