\n ex=g.extract(models,synth,np.arange(2),origin,scoring=True)\n zero=g.score_confirmation(ex,[0.]*4,'cuda')\n reference=g.g8.score_role(models,synth,np.arange(2),origin)\n assert zero['methods']['anchor_t06']==zero['methods']['evidence_correction']\n for name,old in (('base','base'),('anchor_t06','anchor')):\n  for metric,field in (('mae','coordinate_vector_mae_m'),('es','coordinate_vector_es_m')):\n   assert zero['methods'][name][field]==reference['coordinate_vectors'][old][metric]\n for model,snapshot in zip(models,snapshots):\n  assert all(torch.equal(v.detach().cpu(),snapshot[k]) for k,v in model.state_dict().items())\n  assert all(p.grad is None for p in model.parameters())\n if domain in g.LEARN_DOMAINS:synthetic_cal[domain]=ex\n peaks[domain]=torch.cuda.max_memory_allocated()\n del models,snapshots,ck,ex;torch.cuda.empty_cache()\nfit=g.fit_once(synthetic_cal,'cuda')\nassert len(fit['train_loss_by_epoch'])==24 and all(np.isfinite(fit['train_loss_by_epoch']))\nassert len(fit['bounded_coefficients'])==4 and max(abs(x) for x in fit['bounded_coefficients'])<=1.5\nfor domain,pack in synthetic_cal.items():assert abs(float(g._row_weights(pack['gid'],pack['sites']).sum())-.5)<1e-6\nprint(json.dumps({'status':'SYNTHETIC_CUDA_AND_ORIGINAL_PANEL_IDENTITY_VERIFIED','roles':roles,'members':identity,'cuda_peak_bytes':peaks,'only_allowed_training_containers_opened':sorted(opened),'mat_restricted_calls':len(mat_calls),'zero_law_and_mae_es_exact_to_g8':True,'network_tensors_bitwise_unchanged':True,'original_network_gradients_none':True,'synthetic_only_gpu_fit_24_epochs_passed':True},ensure_ascii=False))"],"started_at":"2026-10-10T14:55:46.386453+08:00","seconds":14.365804700006265,"exit_code":0,"stdout_sha256":"6a2dfe1df6061e7ea89ad6d7b0910e47d3318d049c0624ced26c69efdc7c176a","stderr_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"},{"stage":"prepare","argv":["D:\\miniminiconda\\envs\\liuyan\\python.exe","-m","fhm_dapp_tim.fhm_dapp.uji_v17_g10_eviden