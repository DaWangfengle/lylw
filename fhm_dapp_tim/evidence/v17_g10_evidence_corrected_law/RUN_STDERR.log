STAGE {"stage": "identity-and-synthetic-cuda", "argv": ["D:\\miniminiconda\\envs\\liuyan\\python.exe", "-c", "import sys,json,hashlib,os,torch,numpy as np\nfrom pathlib import Path\nfrom fhm_dapp_tim.fhm_dapp import uji_v17_g10_evidence_corrected_law as g\nroot=Path.cwd();data_root=root/'data'\nallowed={root/'data/UTSIndoorLoc/UTS_training.csv',root/'data/Tampere/Training_rss.csv',root/'data/Tampere/Training_coordinates.csv'}\nallowed.update(g.g8.g6.MAT_DIR/g.g8.g6.ds.TUJI_DEVICE_FILES[d] for d in g.g8.g6.EXPECTED_DEVICES)\nallowed={str(p.resolve()).lower() for p in allowed}\nopened=set();mat_calls=[]\ndef hook(event,args):\n if event!='open' or not isinstance(args[0],(str,bytes,os.PathLike)):return\n p=Path(os.fsdecode(args[0])).resolve();s=str(p).lower()\n if str(data_root.resolve()).lower()+os.sep in s:\n  if s not in allowed:raise AssertionError('forbidden data open: '+str(p))\n  mode=args[1];flags=args[2]\n  if (isinstance(mode,str) and any(x in mode for x in ('w','a','+','x'))) or (isinstance(flags,int) and flags & (os.O_WRONLY|os.O_RDWR)):raise AssertionError('data write blocked')\n  opened.add(p.relative_to(root).as_posix())\nsys.addaudithook(hook)\nloadmat=g.g8.g6.loadmat\ndef restricted(path,*args,**kwargs):\n assert tuple(kwargs.get('variable_names',()))==('results_train',)\n obj=loadmat(path,*args,**kwargs)\n assert 'results_test' not in obj\n mat_calls.append(str(path));return obj\ng.g8.g6.loadmat=restricted\nassert torch.cuda.is_available()\nassert not g.MANIFEST.exists() and not g.LOCK.exists()\nfor module in (g.g8,g.g9):\n old=module._read(module.MANIFEST,'manifest_sha256')\n assert module._source_hashes()==old['source_sha256']\nidentity=[];roles={};synthetic_cal={};peaks={}\nfor domain in g.DOMAINS:\n data=g.g8._pack(domain)\n groups=data['groups']\n for a in groups:\n  for b in groups:\n   if a!=b:assert not groups[a]&groups[b]\n roles[domain]={role:{'sites':len(groups[role]),'rows':len(data['rows'][role])} for role in groups}\n models,origin=g.g8._load_models(domain,{'model_and_role_provenance':{domain:data['original']}},'cuda')\n paths=[(g.g8.g6.member_path(i) if domain=='tuji' else g.g8.g4.member_path(i) if domain=='uts' else g.g8.g5.member_path(i)) for i in range(1,6)]\n snapshots=[{k:v.detach().cpu().clone() for k,v in m.state_dict().items()} for m in models]\n ref=models[0]\n for i,(model,path) in enumerate(zip(models,paths),1):\n  ck=torch.load(path,map_location='cpu',weights_only=False)\n  assert int(ck['seed'])==17300+i\n  assert int(ck['epoch'])==[65,69,56,67,62][i-1]\n  for attr in ('anchor_coords','anchor_buildings','anchor_floors','prototype_rss'):\n   assert torch.equal(getattr(model,attr),getattr(ref,attr))\n  assert torch.equal(model.encoder.seen_ap_mask,ref.encoder.seen_ap_mask)\n  assert not model.training\n  identity.append({'domain':domain,'member':i,'seed':ck['seed'],'epoch':ck['epoch'],'sha256':data['original']['checkpoints'][i-1]})\n torch.cuda.reset_peak_memory_stats()\n width=int(data['data']['rss'].shape[1])\n synth={'rss':torch.full((2,width),-90.),'raw_xy':np.array([[1.123456789,2.987654321],[3.987654321,4.123456789]],dtype=np.float64),\n        'keys':[(0,0,1.1235,2.9877),(0,0,3.9877,4.1235)]}\n ex=g.extract(models,synth,np.arange(2),origin,scoring=True)\n zero=g.score_confirmation(ex,[0.]*4,'cuda')\n reference=g.g8.score_role(models,synth,np.arange(2),origin)\n assert zero['methods']['anchor_t06']==zero['methods']['evidence_correction']\n for name,old in (('base','base'),('anchor_t06','anchor')):\n  for metric,field in (('mae','coordinate_vector_mae_m'),('es','coordinate_vector_es_m')):\n   assert zero['methods'][name][field]==reference['coordinate_vectors'][old][metric]\n for model,snapshot in zip(models,snapshots):\n  assert all(torch.equal(v.detach().cpu(),snapshot[k]) for k,v in model.state_dict().items())\n  assert all(p.grad is None for p in model.parameters())\n if domain in g.LEARN_DOMAINS:synthetic_cal[domain]=ex\n peaks[domain]=torch.cuda.max_memory_allocated()\n del models,snapshots,ck,ex;torch.cuda.empty_cache()\nfit=g.fit_once(synthetic_cal,'cuda')\nassert len(fit['train_loss_by_epoch'])==24 and all(np.isfinite(fit['train_loss_by_epoch']))\nassert len(fit['bounded_coefficients'])==4 and max(abs(x) for x in fit['bounded_coefficients'])<=1.5\nfor domain,pack in synthetic_cal.items():assert abs(float(g._row_weights(pack['gid'],pack['sites']).sum())-.5)<1e-6\nprint(json.dumps({'status':'SYNTHETIC_CUDA_AND_ORIGINAL_PANEL_IDENTITY_VERIFIED','roles':roles,'members':identity,'cuda_peak_bytes':peaks,'only_allowed_training_containers_opened':sorted(opened),'mat_restricted_calls':len(mat_calls),'zero_law_and_mae_es_exact_to_g8':True,'network_tensors_bitwise_unchanged':True,'original_network_gradients_none':True,'synthetic_only_gpu_fit_24_epochs_passed':True},ensure_ascii=False))"], "started_at": "2026-10-10T14:55:14.751204+08:00", "seconds": 6.05412729998352, "exit_code": 1, "stdout_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "stderr_sha256": "f2ecdb1fd26e64ea8521dc21245b0dbc0f207e9c3b1e494490ab41aed9e22aa0"}
