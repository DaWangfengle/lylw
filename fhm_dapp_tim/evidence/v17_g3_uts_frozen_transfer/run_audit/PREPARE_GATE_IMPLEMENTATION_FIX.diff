+def _fixed_transfer_gate(delta_mae: float, upper_mae: float,
+                         delta_es: float, upper_es: float,
+                         placebo_delta_mae: float) -> dict:
+    """Implement the preregistered G3 placebo-vs-baseline criterion."""
+    gate = g1.confirm_gate(delta_mae, upper_mae, delta_es, upper_es,
+                           placebo_delta_mae)
+    gate["checks"].pop("geometry_better_than_permuted_density")
+    gate["checks"]["placebo_worse_than_baseline"] = placebo_delta_mae > 0.0
+    gate["passed"] = all(gate["checks"].values())
+    gate["note"] = "Frozen UTS transfer criteria; historical UJI G1 STOP unchanged"
+    return gate
 
 
