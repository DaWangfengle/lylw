ROBE.json": "50058823f32711a00f1f18549ccbdf10af36ea75bd13df68cd072eb6cb8620f4", "fhm_dapp_tim/evidence/v19_r0/V18_5_PREDICTIVE_DECISION_PROBE.md": "fabffad47a97139ece84141554dc119af9c751b46d35cafecd72505de5ad6dc6", "HISTORICAL_REPRODUCTION_CODEX_RUN.txt": "38e70c27967b8852c32efb56e36b7c1f55060e8ef8507e1ba2afd9611723e81b", "V17_G10_CODEX_RUN.txt": "6f8942e4c636d33eb56e443cbc52f70386e6ac2fd738892bd6f2d892af1d96de", "V17_G11_CODEX_RUN.txt": "48fa18148cfd5eff9813eff71ac6aa6db00842dea96d02e0b3aac425f9474ccb", "V17_G12_CODEX_RUN.txt": "53dba736d0f10b30f10df7057889b389aff9883c6e5e8f237e79f25836e9b91d", "V17_G1_CODEX_RUN.txt": "a74d1281086d99714e95c1db9617c23238fc0458948419347c105c7484c324c8", "V17_G2_CODEX_RUN.txt": "ef65f4b8df8497733ec5c86b9d8fb716bf7fd0fdadd16d2947253506409769ba", "V17_G3_CODEX_RUN.txt": "e60acc738621c07d66a8dc5049a6ad5ffe9abe6c1d323bbf81f64d3a16dc3454", "V17_G4_CODEX_RUN.txt": "0c6a523ba328a7a55fcc41e6a78bf6bb012aadade2c8f41935b98d032e236323", "V17_G5_CODEX_RUN.txt": "ff57ecbd431b36d63faf7bcc6ff7ae08898cbaa315ec7c8dfdf6647b2c4c4cb3", "V17_G6_CODEX_RUN.txt": "ac51b681022188b36166cce025ac4705177d6f18fdde567d230920e0442f2b39", "V17_G7_CODEX_RUN.txt": "61b612a7fe3c85fbf0245a6eee3bbd1ebeebc89faca01b8598f26d5a84cee56d", "V17_G8_CODEX_RUN.txt": "cbb564d4f5468dbd22c5ba386b09d172cdac6e8f2e4adf2653c190744e3e91f9", "V17_G9_CODEX_RUN.txt": "44d4a2ed89d67d6a30b346b1e6f4bcbc271193f35506c99384f41024300b75d5", "V18_1_CODEX_RUN.txt": "5d571d310e545a3613757068f7b1b0181c358ca39b38a2ed3125ca76ecb6b8ce", "V18_2_CODEX_RUN.txt": "f33b902ce9d9264dfd1a0385e3aa2f20b1e67e889620930e5d1465c81fd896f3", "V18_3_CODEX_RUN.txt": "f35cca1dff527c7461dd8f6f49383bc01664d67c8ef98b3fd95ada181b4e9f0e"}, "original_model_sha256": {"fhm_dapp_tim/models/v17_g6_distribution_calibration/member_01_seed17301.pt": "20415c513976bbdd2e6aaf911c284d5a3aca271b037c41b859dce7cf89195f2a", "fhm_dapp_tim/models/v17_g6_distribution_calibration/member_02_seed17302.pt": "febeb7b185cee8b05e748616d99342f352b77d6bd0a8a0f758ad3c5a484b44e8", "fhm_dapp_tim/models/v17_g6_distribution_calibration/member_03_seed17303.pt": "73ac17a495574be6ea80989982463083ab4db58b5f87f521fed82846a53ecf0a", "fhm_dapp_tim/models/v17_g6_distribution_calibration/member_04_seed17304.pt": "58bd77a131b59dae28d9e0d513055746383f6f7edf973650fa155cc94ff7611b", "fhm_dapp_tim/models/v17_g6_distribution_calibration/member_05_seed17305.pt": "124626cbf93dd9b834a5325b61c6ff7735ed89254c9a16fae174d0a9bd79d26c", "fhm_dapp_tim/models/v17_g4_observable_support/member_01_seed17301.pt": "299b5955967acc333fccef45d6a83ca45af4a6e073bf64a909ba9889dabb4fb5", "fhm_dapp_tim/models/v17_g4_observable_support/member_02_seed17302.pt": "3bf3db6c88d3189529623106af2e1463e44b17408965eeecd98a739efa8d9b48", "fhm_dapp_tim/models/v17_g4_observable_support/member_03_seed17303.pt": "4e56c499c837a40d45c9a40b984ec12eb7bc9f10dd8db5ae2b549103d05e7548", "fhm_dapp_tim/models/v17_g4_observable_support/member_04_seed17304.pt": "695b0afbc0c282f20f6f7f41d385b842b169ef366c75f0c010e5f27f24bd1224", "fhm_dapp_tim/models/v17_g4_observable_support/member_05_seed17305.pt": "0067c6a6f4d88c5dc49a9159d26304802be14e31f6cbcf23b91c29555c5ef25c"}, "G13_original_sources": {"fhm_dapp_tim/fhm_dapp/uji_v17_g13_multiscan_observation.py": {"sha256": "5f422945a9f87e5f3660fe6a093aa8fe3ea37de0c44a9983e7b067688a962f07", "text": "\"\"\"G13: FIT-only multi-scan AP-detection and conditional-RSS evidence pilot.\n\nOne frozen two-coefficient observation model pooled on previously seen\nTUJI/UTS CAL, tested descriptively on previously seen CONFIRM. No Tampere,\nno official test, no new neural model training. UJIIndoorLoc is explicitly\nreserved for a separate future independent protocol (different E5 panel).\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport math\nfrom pathlib import Path\nfrom typing import Sequence\n\nimport numpy as np\nimport torch\n\nfrom fhm_dapp_tim.fhm_dapp import uji_v17_g8_hierarchical_attribution as g8\nfrom fhm_dapp_tim.fhm_dapp import uji_v17_g10_evidence_corrected_law as g10\nfrom fhm_dapp_tim.fhm_dapp import uji_v17_g11_rss_identifiability as g11\nfrom fhm_dapp_tim.fhm_dapp import uji_v17_mother_r2b as r2b\nfrom fhm_dapp_tim.fhm_dapp import uji_v17_mother_r3 as r3\nfrom fhm_dapp_tim.fhm_dapp import uji_v17_mother_r3_protocol as r3p\nfrom fhm_dapp_tim.fhm_dapp.coherent_marked_v9 import common_student_t_randomness\nfrom fhm_dapp_tim.fhm_dapp.experiment_v7 import (\n    _canonical_json_sha256, _sha256_file, _write_json_new,\n)\n\nROOT=Path(__file__).resolve().parents[1]\nOUT=ROOT/\"evidence/v17_g13_multiscan_observation\"\nDESIGN=OUT/\"DESIGN_V17_G13.md\"\nMANIFEST=OUT/\"manifest_v17_g13.json\"\nLOCK=OUT/\"pilot_v17_g13.lock\"\nCOEFFICIENTS=OUT/\"coefficients_v17_g13.json\"\nRESULT=OUT/\"evaluation_v17_g13.json\"\nREPORT=OUT/\"RUN_REPORT_V17_G13.md\"\nPROTOCOL=\"g13_multiscan_fit_bernoulli_conditional_student_observation_v1\"\nDOMAINS=(\"tuji\",\"uts\")\nROLES=(\"calibration\",\"confirmation\")\nVARIANTS=(\"base\",\"anchor_t06\",\"visibility\",\"strength\",\"joint\")\nE,L,K=5,192,192\nTEMP=.6\nKAPPA=4.\nBETA=.5\nDF_RSS=4.\nSIGMA_FLOOR=.06          # normalized model RSS (~3.3 dBm), avoid overprecision\nBATCH=12\nTRAIN_BATCH=24\nEPOCHS=24\nLR=.05\nCOEFF_CAP=1.5\nSEED=20261012\nPOINT_WEIGHT=.30\nKL_WEIGHT=.10\nSCALE_M=10.\nMC_SEED=g8.SEED\n\n\nclass G13Error(RuntimeError):\n    pass\n\n\ndef _record(value:dict,field:str=\"result_sha256\")->dict:\n    result=dict(value)\n    result[field]=_canonical_json_sha256(result)\n    return result\n\n\ndef _write(path:Path,value:dict,field:str=\"result_sha256\")->dict:\n    if path.exists():\n        raise FileExistsError(f\"immutable G13 artifact already exists: {path}\")\n    obj=_record(value,field)\n    path.parent.mkdir(parents=True,exist_ok=True)\n    _write_json_new(path,obj)\n    return obj\n\n\ndef _read(path:Path,field:str=\"result_sha256\")->dict:\n    obj=json.loads(path.read_text(encoding=\"utf-8\"))\n    if obj.get(field)!=_canonical_json_sha256(obj,omit=field):\n        raise G13Error(f\"immutable G13 artifact hash mismatch: {path}\")\n    return obj\n\n\ndef _source_hashes()->dict:\n    files={\n        \"G13_design\":DESIGN,\n        \"G13_science\":Path(__file__),\n        \"G13_tests\":ROOT.parent/\"tests/test_uji_v17_g13_multiscan_observation.py\",\n        \"G8_model_protocol\":Path(g8.__file__),\n        \"G10_existing_surrogate\":Path(g10.__file__),\n        \"G11_FIT_to_anchor_bijection\":Path(g11.__file__),\n        \"R3_original_law\":Path(r3.__file__),\n        \"R2B_original_prototypes\":Path(r2b.__file__),\n        \"R3_original_protocol\":Path(r3p.__file__),\n    }\n    return {k:_sha256_file(v) for k,v in files.items()}\n\n\ndef _pack(domain:str)->dict:\n    if domain not in DOMAINS:\n        raise G13Error(\"G13 is ONLY TUJI+UTS multi-scan; no Tampere\")\n    p=g8._pack(domain)  # historic FIT/CAL/CONFIRM physical sites; no scores\n    if any(len(p[\"rows\"][role])==0 for role in (\"fit\",)+ROLES):\n        raise G13Error(\"missing physical role rows\")\n    return p\n\n\ndef preflight()->dict:\n    sources={d:_pack(d)[\"original\"] for d in DOMAINS}\n    if (g8.E!=E or g8.g6.L!=L or g8.K!=K or g8.T!=TEMP\n        or r3p.STUDENT_DF!=4. or r3p.PREDICTIVE_DRAWS_PER_STREAM!=64):\n        raise G13Error(\"historical V17 original protocol changed\")\n    return {\n        \"protocol\":PROTOCOL,\"status\":\"G13_FIT_ONLY_TWO_DOMAIN_READY\",\n        \"domains\":list(DOMAINS),\"roles\":list(ROLES),\n        \"original_E5_panel_provenance\":sources,\n        \"source_sha256\":_source_hashes(),\n        \"uiji_policy\":\"UJIIndoorLoc only after a separate truly independent protocol; do not access here\",\n        \"tampere_in_study\":False,\n        \"old_CONFIRM_labels_already_seen\":True,\n        \"no_original_training_or_official_test\":True,\n    }\n\n\ndef prepare()->dict:\n    info=preflight()\n    config={\n        \"protocol\":PROTOCOL,\"source_sha256\":info[\"source_sha256\"],\n        \"original_E5_panel_provenance\":info[\"original_E5_panel_provenance\"],\n        \"domains\":list(DOMAINS),\"roles\":list(ROLES),\n        \"variants\":list(VARIANTS),\"fixed_temp\":TEMP,\n        \"multi_scan\":{\"missing_cutoff_model_rss\":-0.999,\n            \"global_reference_strength\":\"detected observations only\",\n            \"ap_bernoulli_beta_base\":BETA,\"per_anchor_shrinkage_pseudoscans\":KAPPA,\n            \"rss_student_df\":DF_RSS,\"normalized_min_rss_sigma\":SIGMA_FLOOR,\n            \"model_seen_aps_only\":True,\n            \"not_independent_scans_assumption\":\"repeated scans correlated; descriptive pilot\"},\n        \"features\":\"per query K192 candidate demeaned standard-deviation-stabilized \"\n                   \"log Bernoulli detection and conditional Student-t RSS likelihood\",\n        \"training\":{\"train_on\":\"historical TUJI/UTS CAL only\",\n            \"sites_equal_weight\":True,\"domains_equal_weight\":True,\n            \"initial_coefficients\":[0.,0.],\"nonnegative_cap\":COEFF_CAP,\n            \"seed\":SEED,\"optimizer\":\"Adam\",\"lr\":LR,\"epochs\":EPOCHS,\n            \"batch\":TRAIN_BATCH,\n            \"loss\":\"Dirac component-centre ES + 0.30 point Euclidean MAE, \"\n                   \"divided by 10m, +0.10 KL to anchor-only T0.6\"},\n        \"evaluation\":{\"roles\":[\"historical confirmation only\"],\n            \"continuous_student_df\":r3p.STUDENT_DF,\n            \"continuous_ES_MC_seed\":MC_SEED,\n            \"draws_each_of_two_streams\":r3p.PREDICTIVE_DRAWS_PER_STREAM,\n            \"preserve_member_centres_scales\":True},\n        \"primary_comparison\":\"joint minus anchor_t06, MAE+ES, p90/p95, worsening sites\",\n        \"descriptive_screen\":\"TUJI and UTS each >=0.15m MAE gain and ES nonworsening\",\n        \"scientific_status\":\"historical exposed domain evidence, NOT independent test\",\n        \"tampere_excluded\":True,\"uji_reserved_untouched\":True,\n    }\n    config[\"manifest_sha256\"]=_canonical_json_sha256(config)\n    if MANIFEST.is_file():\n        if _read(MANIFEST,\"manifest_sha256\")!=config:\n            raise G13Error(\"immutable scientific manifest differs\")\n        return config\n    _write_json_new(MANIFEST,config)\n    return config\n\n\ndef build_fit_observation_memory(\n    fit_rss:torch.Tensor, fit_anchor_ids:torch.Tensor,\n    anchor_count:int,seen:torch.Tensor,\n    kappa:float=KAPPA,\n)->dict[str,torch.Tensor]:\n    \"\"\"Shrink multi-scan per-anchor Bernoulli visibility and conditional RSS.\n\n    Missing is NOT an observed weak RSS. FIT alone supplies site prototypes.\n    Global priors use FIT rows only. There are no validation/target labels.\n    \"\"\"\n    x=fit_rss.detach().cpu().float()\n    ids=fit_anchor_ids.detach().cpu().long()\n    seen=seen.detach().cpu().bool()\n    if (x.ndim!=2 or ids.shape!=(len(x),) or seen.shape!=(x.shape[1],)\n        or anchor_count<1 or len(x)<anchor_count or not torch.isfinite(x).all()\n        or not bool(seen.any()) or float(kappa)<=0.):\n        raise G13Error(\"invalid FIT observation inputs\")\n    if ids.min()<0 or ids.max()>=anchor_count:\n        raise G13Error(\"FIT indices outside original anchor dictionary\")\n    x=x[:,seen]\n    mask=(x>-0.999)\n    binary=mask.float()\n    a=anchor_count;p=x.shape[1]\n    counts=torch.bincount(ids,minlength=a).float()\n    if (counts<=0).any():\n        raise G13Error(\"FIT anchor lacks scans\")\n    detections=torch.zeros(a,p)\n    detections.index_add_(0,ids,binary)\n    global_vis=(detections.sum(0)+BETA)/(float(len(x))+2*BETA)\n    # A hierarchical Beta prior with strength kappa; global rate learned\n    # from FIT itself, not an unrelated uniform 50% AP prior.\n    prob=(detections+kappa*global_vis[None,:])/(counts[:,None]+kappa)\n    prob=prob.clamp(1e-5,1.-1e-5)\n    sum_x=torch.zeros(a,p)\n    sum_sq=torch.zeros(a,p)\n    measured=torch.where(mask,x,0.)\n    sum_x.index_add_(0,ids,measured)\n    sum_sq.index_add_(0,ids,measured.square())\n    glob_d=detections.sum(0)\n    glob_mu=measured.sum(0)/glob_d.clamp_min(1)\n    glob_sq=measured.square().sum(0)/glob_d.clamp_min(1)\n    glob_var=(glob_sq-glob_mu.square()).clamp_min(SIGMA_FLOOR**2)\n    # Conditional RSS posterior shrinkage, not a global [-1] imputation.\n    mu=(sum_x+kappa*glob_mu[None,:])/(detections+kappa)\n    centred_ss=(sum_sq-2*mu*sum_x+mu.square()*detections)\n    # Prior shifts keep a single-scan anchor from having zero variance.\n    prior_ss=kappa*(glob_var[None,:]+(glob_mu[None,:]-mu).square())\n    variance=((centred_ss+prior_ss)/(detections+kappa)).clamp(\n        min=SIGMA_FLOOR**2,max=1.)\n    if not (torch.isfinite(prob).all() and torch.isfinite(mu).all()\n            and torch.isfinite(variance).all()):\n        raise G13Error(\"nonfinite FIT observation memory\")\n    return {\n        \"detection_probability\":prob,\n        \"conditional_mean\":mu,\n        \"conditional_variance\":variance,\n        \"fit_rows_per_anchor\":counts,\n        \"detections_per_anchor\":detections,\n        \"model_ap_count\":torch.tensor(p),\n        \"global_detection_probability\":global_vis,\n    }\n\n\ndef _stabilize(x:torch.Tensor)->torch.Tensor:\n    centred=x-x.mean(dim=1,keepdim=True)\n    # Stability floor prevents amplifying essentially identical candidate\n    # scores into artificially high-confidence contrast.\n    return centred/torch.sqrt(\n        centred.square().mean(dim=1,keepdim=True)+0.20**2)\n\n\ndef observation_features(\n    query_rss:torch.Tensor, candidate_ids:torch.Tensor,\n    seen:torch.Tensor, memory:dict[str,torch.Tensor],\n)->torch.Tensor:\n    \"\"\"Per candidate, independent Bernoulli detect and conditional-t RSS terms.\n\n    No query building/floor/XY, device identifier, or target labels used.\n    The candidate identity is the original R3 Top-K ID, never an oracle ID.\n    \"\"\"\n    if query_rss.ndim!=2 or candidate_ids.ndim!=2:\n        raise G13Error(\"invalid observation query geometry\")\n    device=query_rss.device\n    seen=seen.to(device).bool()\n    x=query_rss[:,seen].float()\n    ids=candidate_ids.long()\n    if (len(x)!=len(ids) or x.shape[1]!=\n        int(memory[\"model_ap_count\"]) or ids.min()<0 or\n        ids.max()>=len(memory[\"detection_probability\"])):\n        raise G13Error(\"query AP schema / candidate IDs mismatch\")\n    z=x>-0.999\n    pi=memory[\"detection_probability\"].to(device)[ids]\n    mu=memory[\"conditional_mean\"].to(device)[ids]\n    var=memory[\"conditional_variance\"].to(device)[ids]\n    vis=torch.where(z[:,None,:],pi.log(),torch.log1p(-pi)).mean(dim=2)\n    # Student-t log p(observed RSS | detected, anchor), common constants\n    # cancel across anchors. Visibility term handles absent APs separately.\n    diff=(x[:,None,:]-mu).square()/(DF_RSS*var)\n    log_strength=-(DF_RSS+1.)/2.*torch.log1p(diff)-.5*var.log()\n    sig=(z[:,None,:]*log_strength).sum(dim=2)/z.sum(dim=1).clamp_min(1)[:,None]\n    sig=torch.where(z.any(1)[:,None],sig,torch.zeros_like(sig))\n    features=torch.stack([_stabilize(vis),_stabilize(sig)],dim=2)\n    if not torch.isfinite(features).all():\n        raise G13Error(\"nonfinite observation likelihood features\")\n    return features\n\n\ndef probability(c:torch.Tensor,features:torch.Tensor,\n                coeff:torch.Tensor)->torch.Tensor:\n    if (c.ndim!=2 or features.shape!=(len(c),c.shape[1],2)\n        or coeff.shape!=(2,) or (coeff<0).any() or (coeff>COEFF_CAP+1e-6).any()):\n        raise G13Error(\"invalid G13 fixed anchor evidence coefficients\")\n    logit=c.clamp_min(1e-30).log()/TEMP+(features*coeff).sum(-1)\n    result=torch.softmax(logit,dim=1)\n    if not torch.isfinite(result).all():\n        raise G13Error(\"nonfinite observation-updated posterior\")\n    return result\n\n\n@torch.no_grad()\ndef extract(models:list,data:dict,rows:np.ndarray,origin:np.ndarray,\n            memory:dict, scoring:bool=False)->dict:\n    \"\"\"Evaluate original frozen R3 exactly, then query FIT observation model.\"\"\"\n    ref=models[0];device=next(ref.parameters()).device\n    row_keys=[data[\"keys\"][int(i)] for i in rows]\n    gid,keys=r2b._coordinate_groups(row_keys)\n    y=torch.as_tensor(data[\"raw_xy\"][rows]-origin[None,:],\n                      device=device,dtype=torch.float64)\n    seen=ref.encoder.seen_ap_mask.detach().to(device).bool()\n    if (seen.sum()!=memory[\"model_ap_count\"] or len(rows)<1 or\n        int(ref.n_anchors)<K):\n        raise G13Error(\"FIT observation AP mapping mismatch\")\n    accum={k:[] for k in (\"c\",\"member\",\"features\",\"centres\",\n                          \"component_p\",\"component_xy\",\"component_scale\")}\n    with r3.r2f_a1._deterministic_algorithms():\n        for start in range(0,len(rows),BATCH):\n            end=min(start+BATCH,len(rows))\n            b=end-start\n            rss=data[\"rss\"][rows[start:end]].float().to(device)\n            proto=r2b._prototype_distance(ref,rss)\n            idx=torch.arange(ref.n_anchors,device=device)[None,:].expand(b,-1)\n            logits=[];xy_all=[];scale_all=[]\n            for model in models:\n                embedding=model.encoder(rss)\n                logits.append(model.retrieval_logits_from_embedding(embedding))\n                location,scale=model._components(embedding,idx)\n                xy_all.append(location);scale_all.append(scale)\n            priors=torch.softmax(\n                r3p.BETA_NEURAL*torch.stack(logits)-\n                r3p.BETA_PROTOTYPE*proto[None,:,:],dim=2)\n            top,ix,rad,_=r3._member_top_l(\n                priors,torch.stack(xy_all),torch.stack(scale_all),L,\n                student_df=r3p.STUDENT_DF)\n            joint,locations,sigma=r3._dense_joint_law(\n                top,ix,rad,torch.stack(xy_all),torch.stack(scale_all),\n                tuple(range(E)),top_k=K,alpha=g8.g6.ALPHA)\n            wm=joint.reshape(b,E,K).sum(2)\n            c=joint.reshape(b,E,K).sum(1)\n            old_w=rad.square().clamp_min(1e-8).reciprocal()\n            old_w=old_w/old_w.sum(dim=0,keepdim=True).clamp_min(1e-30)\n            candidate_ids,independent_c=r3.dense_alpha_consensus_prior(\n                top,ix,old_w,int(ref.n_anchors),K,\n                epsilon=r3.CONSENSUS_EPSILON,alpha=g8.g6.ALPHA)\n            if not torch.allclose(c,independent_c,rtol=3e-6,atol=3e-6):\n                raise G13Error(\"original R3 marginal/candidate alignment failure\")\n            features=observation_features(rss,candidate_ids,seen,memory)\n            selected_centres=(\n                wm[:,:,None,None]*locations.reshape(b,E,K,2)).sum(dim=1)\n            for k,value in (\n                (\"c\",c),(\"member\",wm),(\"features\",features),\n                (\"centres\",selected_centres),\n                (\"component_p\",joint),(\"component_xy\",locations),\n                (\"component_scale\",sigma)):\n                if not scoring and k.startswith(\"component_\"):\n                    continue\n                accum[k].append(value.detach().cpu())\n    return {**{k:torch.cat(v,dim=0) for k,v in accum.items() if v},\n            \"target\":y.detach().cpu(),\"gid\":gid.detach().cpu(),\n            \"keys\":[list(key) for key in keys],\"rows\":len(rows),\n            \"sites\":len(keys)}\n\n\ndef _row_weights(gid:torch.Tensor,sites:int)->torch.Tensor:\n    size=torch.bincount(gid.long(),minlength=sites).float()\n    if (size<=0).any():raise G13Error(\"empty CAL physical site\")\n    return 1./(size[gid.long()]*sites)\n\n\ndef fit(cal:dict[str,dict],device_name:str)->dict:\n    \"\"\"Exactly one pooled, nonnegative 2-scalar fit on CAL only.\"\"\"\n    torch.manual_seed(SEED)\n    device=torch.device(device_name)\n    raw=torch.nn.Parameter(torch.zeros(2,device=device))\n    optimizer=torch.optim.Adam([raw],lr=LR)\n    losses=[]\n    for epoch in range(EPOCHS):\n        optimizer.zero_grad(set_to_none=True)\n        total_loss=0.\n        for domain in DOMAINS:\n            p=cal[domain]\n            rw=_row_weights(p[\"gid\"],p[\"sites\"]).to(device)\n            for start in range(0,p[\"rows\"],TRAIN_BATCH):\n                end=min(start+TRAIN_BATCH,p[\"rows\"])\n                c=p[\"c\"][start:end].to(device)\n                z=p[\"features\"][start:end].to(device)\n                means=p[\"centres\"][start:end].to(device)\n                y=p[\"target\"][start:end].to(device).float()\n                theta=raw.clamp(0.,COEFF_CAP)\n                q=probability(c,z,theta)\n                baseline=torch.softmax(c.clamp_min(1e-30).log()/TEMP,dim=1)\n                # Existing G10 surrogate: exact Dirac-mixture proper energy,\n                # not the continuous Student-t ES scored at confirmation.\n                es=g10.discrete_energy_loss(q,means,y)\n                point=torch.linalg.vector_norm(\n                    (q[:,:,None]*means).sum(1)-y,dim=1)\n                kl=(q*(q.clamp_min(1e-30).log()-\n                       baseline.clamp_min(1e-30).log())).sum(1)\n                loss=((es+POINT_WEIGHT*point)/SCALE_M+\n                      KL_WEIGHT*kl)\n                term=.5*(loss*rw[start:end]).sum()\n                if not torch.isfinite(term):\n                    raise G13Error(\"nonfinite train-only CAL objective\")\n                term.backward()\n                total_loss+=float(term.detach().cpu())\n        optimizer.step()\n        with torch.no_grad():\n            raw.clamp_(0.,COEFF_CAP)\n        losses.append(total_loss)\n    theta=raw.detach().cpu().tolist()\n    return {\n        \"protocol\":PROTOCOL,\n        \"coefficients\":{\"visibility\":theta[0],\"strength\":theta[1]},\n        \"train_loss_by_epoch\":losses,\n        \"epochs\":EPOCHS,\"lr\":LR,\n        \"fitting_roles\":{d:{\"CAL_rows\":cal[d][\"rows\"],\n                            \"CAL_sites\":cal[d][\"sites\"]} for d in DOMAINS},\n        \"no_confirmation_fitting\":True,\n        \"train_loss_not_continuous_Student_t_ES\":True,\n        \"source_candidate_anchor_only_T\":TEMP,\n    }\n\n\ndef _variant_probabilities(pack:dict,start:int,end:int,theta:torch.Tensor,\n                           device:torch.device)->dict[str,torch.Tensor]:\n    original=pack[\"component_p\"][start:end].to(device)\n    f=pack[\"features\"][start:end].to(device)\n    p=original.reshape(end-start,E,K)\n    w=p.sum(2);c=p.sum(1)\n    # Keep original BASE float32 exact, use original G8 anchor-only law.\n    anchor=g8.hierarchical_laws(original,E,K)[\"anchor\"]\n    zero=torch.zeros_like(theta)\n    qv=probability(c,f,torch.stack((theta[0],zero[1])))\n    qs=probability(c,f,torch.stack((zero[0],theta[1])))\n    qj=probability(c,f,theta)\n    def joint(q):\n        return (w[:,:,None]*q[:,None,:]).reshape(end-start,E*K)\n    if not torch.allclose(\n        joint(probability(c,f,zero)),anchor,atol=3e-6,rtol=3e-6):\n        raise G13Error(\"zero learned evidence fails to reproduce strong baseline\")\n    return {\"base\":original,\"anchor_t06\":anchor,\"visibility\":joint(qv),\n            \"strength\":joint(qs),\"joint\":joint(qj)}\n\n\ndef score(pack:dict,theta:list[float],device_name:str)->dict:\n    device=torch.device(device_name)\n    coeff=torch.tensor(theta,dtype=torch.float32,device=device)\n    n=pack[\"rows\"]\n    rnd=common_student_t_randomness(\n        n,draws=r3p.PREDICTIVE_DRAWS_PER_STREAM,\n        degrees_freedom=r3p.STUDENT_DF,seed=MC_SEED)\n    scores={v:{\"mae\":torch.empty(n,dtype=torch.float64),\n               \"es\":torch.empty(n,dtype=torch.float64)} for v in VARIANTS}\n    with r3.r2f_a1._deterministic_algorithms():\n        for start in range(0,n,BATCH):\n            end=min(start+BATCH,n)\n            q=_variant_probabilities(pack,start,end,coeff,device)\n            loc=pack[\"component_xy\"][start:end].to(device)\n            sigma=pack[\"component_scale\"][start:end].to(device)\n            target=pack[\"target\"][start:end].to(device)\n            random=g8.g6._random_slice(rnd,start,end,device)\n            for name,prior in q.items():\n                es,mae=r3._score_joint_law(prior,loc,sigma,target,random)\n                scores[name][\"mae\"][start:end]=mae.double().detach().cpu()\n                scores[name][\"es\"][start:end]=es.double().detach().cpu()\n    grouped=pack[\"gid\"];sites=pack[\"sites\"]\n    out={}\n    for name in VARIANTS:\n        mae,site_mae=r3._metric_record(scores[name][\"mae\"],grouped,sites)\n        es,site_es=r3._metric_record(scores[name][\"es\"],grouped,sites)\n        ma=site_mae.tolist();ee=site_es.tolist()\n        out[name]={\n            \"macro_mae_m\":float(mae[\"coordinate_macro_m\"]),\n            \"macro_ES_m\":float(es[\"coordinate_macro_m\"]),\n            \"p90_site_mae_m\":float(np.quantile(ma,.9)),\n            \"p95_site_mae_m\":float(np.quantile(ma,.95)),\n            \"worst_site_mae_m\":max(ma),\n            \"site_mae_m\":ma,\"site_ES_m\":ee,\n        }\n    old=np.asarray(out[\"anchor_t06\"][\"site_mae_m\"])\n    new=np.asarray(out[\"joint\"][\"site_mae_m\"])\n    old_es=np.asarray(out[\"anchor_t06\"][\"site_ES_m\"])\n    new_es=np.asarray(out[\"joint\"][\"site_ES_m\"])\n    return {\n        \"rows\":n,\"physical_sites\":sites,\"physical_coordinate_keys\":pack[\"keys\"],\n        \"methods\":out,\n        \"joint_minus_anchor\":{\n            \"delta_mae_m\":float((new-old).mean()),\n            \"delta_ES_m\":float((new_es-old_es).mean()),\n            \"sites_improve\":int((new<old).sum()),\n            \"sites_worsen\":int((new>old).sum()),\n            \"largest_added_site_error_m\":float((new-old).max()),\n        },\n        \"MC_seed\":MC_SEED,\"draws_per_stream\":r3p.PREDICTIVE_DRAWS_PER_STREAM,\n    }\n\n\ndef _report(result:dict)->str:\n    lines=[\n        \"# G13 | Multi-scan AP visibility × conditional RSS evidence\",\n        \"\",\n        \"**Retrospective TUJI/UTS only; all CONFIRM labels previously exposed.**\",\n        \"No Tampere, no official UJIIndoorLoc test, no E5 retraining.\",\n        \"Only two pooled coefficients learned on original CAL.\",\n        \"\",\n        \"| Domain | Policy | Macro MAE m | Full Student-t ES m | P90 m | P95 m |\",\n        \"|---|---|---:|---:|---:|---:|\",\n    ]\n    for domain in DOMAINS:\n        for name in VARIANTS:\n            v=result[\"confirm\"][domain][\"methods\"][name]\n            lines.append(f\"| {domain} | {name} | {v['macro_mae_m']:.6f} | \"\n                         f\"{v['macro_ES_m']:.6f} | \"\n                         f\"{v['p90_site_mae_m']:.6f} | {v['p95_site_mae_m']:.6f} |\")\n    lines.extend([\"\",\"## FIT-scan support and learned evidence coefficients\",\"\"])\n    for domain in DOMAINS:\n        st=result[\"fit_observation_stats\"][domain]\n        lines.append(f\"- {domain}: FIT scans per reference site \"\n                     f\"min/median/max={st['scan_min']}/{st['scan_median']}/{st['scan_max']}; \"\n                     f\"sites with >=2 scans={st['sites_at_least_two']}/{st['sites']}\")\n    lines.append(f\"- learned coefficients: {result['coefficients']['coefficients']}\")\n    lines.append(\"\")\n    lines.append(f\"**{result['status']}** (DESCRIPTIVE screening, not promotion).\")\n    lines.append(\"\")\n    lines.append(\"AP detection clipping at -1, conditional independence,\")\n    lines.append(\"FIT scan correlation, heterogeneous devices and reused\")\n    lines.append(\"historical CONFIRM outcomes limit causal/generalization claims.\")\n    lines.append(\"UJIIndoorLoc needs a separate, unviewed prospective protocol.\")\n    lines.append(\"\")\n    lines.append(f\"Result SHA: {result['result_sha256']}\")\n    lines.append(\"\")\n    return \"\\n\".join(lines)\n\n\ndef run(device_name:str=\"cuda\")->dict:\n    if LOCK.exists() or RESULT.exists() or COEFFICIENTS.exists():\n        raise G13Error(\"G13 already locked or fitted: no repeated confirmation\")\n    manifest=prepare()\n    lock=_write(LOCK,{\n        \"protocol\":PROTOCOL,\"manifest_file_sha256\":_sha256_file(MANIFEST),\n        \"before_any_CONFIRM_scoring\":True,\n        \"multi_scan_domains\":list(DOMAINS)})\n    packs={}\n    cal={}\n    stats={}\n    for domain in DOMAINS:\n        p=_pack(domain)\n        models,origin=g8._load_models(\n            domain,{\"model_and_role_provenance\":\n                    manifest[\"original_E5_panel_provenance\"]},device_name)\n        ref=models[0]\n        fit_ids=p[\"rows\"][\"fit\"]\n        fit_rss=p[\"data\"][\"rss\"][fit_ids]\n        fit_group,_=g11.map_fit_rows_to_model_anchors(\n            fit_ids,p[\"data\"],ref,origin)\n        memory=build_fit_observation_memory(\n            fit_rss,fit_group,int(ref.n_anchors),\n            ref.encoder.seen_ap_mask.detach().cpu())\n        counts=memory[\"fit_rows_per_anchor\"].tolist()\n        stats[domain]={\n            \"sites\":len(counts),\"scan_min\":int(min(counts)),\n            \"scan_median\":float(np.median(counts)),\"scan_max\":int(max(counts)),\n            \"sites_at_least_two\":sum(x>=2 for x in counts),\n            \"sites_at_least_five\":sum(x>=5 for x in counts),\n            \"model_seen_APs\":int(memory[\"model_ap_count\"]),\n        }\n        # CAL ONLY until fit() is finalized: no confirmation feature or\n        # target cached, selected, or used in the optimizer.\n        cal[domain]=extract(models,p[\"data\"],p[\"rows\"][\"calibration\"],\n                            origin,memory,scoring=False)\n        packs[domain]={\"data\":p[\"data\"],\"rows\":p[\"rows\"],\n                       \"models\":models,\"origin\":origin,\"memory\":memory}\n    learned=fit(cal,device_name)\n    frozen=_write(COEFFICIENTS,{\n        **learned,\"lock_file_sha256\":_sha256_file(LOCK),\n        \"manifest_file_sha256\":_sha256_file(MANIFEST)})\n    coeff=[frozen[\"coefficients\"][\"visibility\"],frozen[\"coefficients\"][\"strength\"]]\n    confirm={}\n    for domain in DOMAINS:\n        p=packs[domain]\n        eval_data=extract(p[\"models\"],p[\"data\"],p[\"rows\"][\"confirmation\"],\n                          p[\"origin\"],p[\"memory\"],scoring=True)\n        confirm[domain]=score(eval_data,coeff,device_name)\n        del p[\"models\"]\n        if torch.cuda.is_available():torch.cuda.empty_cache()\n    passed=all(\n        confirm[d][\"joint_minus_anchor\"][\"delta_mae_m\"]<=-.15\n        and confirm[d][\"joint_minus_anchor\"][\"delta_ES_m\"]<=0\n        for d in DOMAINS)\n    result=_write(RESULT,{\n        \"protocol\":PROTOCOL,\n        \"status\":(\"PROMISING_RETROSPECTIVE_EVIDENCE\" if passed\n                  else \"NO_RETROSPECTIVE_ADVANCEMENT\"),\n        \"descriptive_screen_passed\":passed,\n        \"confirm\":confirm,\n        \"fit_observation_stats\":stats,\n        \"coefficients\":frozen,\n        \"manifest_file_sha256\":_sha256_file(MANIFEST),\n        \"lock_file_sha256\":_sha256_file(LOCK),\n        \"coefficients_file_sha256\":_sha256_file(COEFFICIENTS),\n        \"not_new_independent_confirmation\":True,\n        \"no_tampere\":True,\"UJIIndoorLoc_reserved_for_future\":True,\n        \"no_original_E5_training\":True,\n    })\n    REPORT.write_text(_report(result),encoding=\"utf-8\",newline=\"\\n\")\n    return {\n        \"status\":result[\"status\"],\"result_sha256\":result[\"result_sha256\"],\n        \"learned_coefficients\":frozen[\"coefficients\"],\n        \"domain_comparisons\":{d:confirm[d][\"joint_minus_anchor\"] for d in DOMAINS},\n    }\n\n\ndef check()->dict:\n    if not MANIFEST.exists():return {\"status\":\"UNPREPARED\"}\n    prepare()\n    if not LOCK.exists():return {\"status\":\"FROZEN_READY\"}\n    lock=_read(LOCK)\n    if lock[\"manifest_file_sha256\"]!=_sha256_file(MANIFEST):\n        raise G13Error(\"lock provenance mismatch\")\n    if not RESULT.exists():\n        return {\"status\":\"G13_LOCK_WITHOUT_RESULT_STOP\"}\n    fitted=_read(COEFFICIENTS)\n    result=_read(RESULT)\n    if (result[\"coefficients_file_sha256\"]!=_sha256_file(COEFFICIENTS)\n        or result[\"manifest_file_sha256\"]!=_sha256_file(MANIFEST)\n        or result[\"lock_file_sha256\"]!=_sha256_file(LOCK)\n        or fitted[\"manifest_file_sha256\"]!=_sha256_file(MANIFEST)):\n        raise G13Error(\"G13 score or coefficient identity changed\")\n    if not REPORT.exists() or REPORT.read_text(encoding=\"utf-8\")!=_report(result):\n        raise G13Error(\"G13 report does not reproduce result\")\n    return {\"status\":\"VERIFIED\",\"result_sha256\":result[\"result_sha256\"],\n            \"scientific_status\":result[\"status\"]}\n\n\ndef main(argv:Sequence[str]|None=None)->int:\n    parser=argparse.ArgumentParser(description=__doc__)\n    subs=parser.add_subparsers(dest=\"command\",required=True)\n    for action in (\"preflight\",\"prepare\",\"run\",\"check\"):\n        sub=subs.add_parser(action)\n        if action==\"run\":sub.add_argument(\"--device\",default=\"cuda\")\n    args=parser.parse_args(argv)\n    payload=(preflight() if args.command==\"preflight\" else\n             prepare() if args.command==\"prepare\" else\n             run(args.device) if args.command==\"run\" else check())\n    print(json.dumps(payload,ensure_ascii=False,indent=2,allow_nan=False))\n    return 0\n\n\nif __name__==\"__main__\":\n    raise SystemExit(main())\n"}, "tests/test_uji_v17_g13_multiscan_observation.py": {"sha256": "a09a091d4b844b16e5c7317ad3a2aca5eb38b8c7100072831480ad3be7b21b22", "text": "\"\"\"G13 scientific CPU invariants; no private data, no GPUs, no historical labels.\"\"\"\nfrom __future__ import annotations\n\nimport inspect\nimport json\n\nimport pytest\nimport torch\n\nfrom fhm_dapp_tim.fhm_dapp import uji_v17_g13_multiscan_observation as g13\n\n\ndef toy_fit():\n    # Four repeated RSS observations at each of two FIT reference anchors.\n    fit=torch.tensor([\n        [.20,.11],[.22,.12],[.18,.10],[.21,.13],\n        [-1.,-.45],[-1.,-.40],[-1.,-.43],[-1.,-.42]\n    ])\n    ids=torch.tensor([0,0,0,0,1,1,1,1],dtype=torch.long)\n    seen=torch.tensor([True,True])\n    return fit,ids,seen\n\n\ndef test_study_excludes_tampere_and_reserves_uji():\n    assert g13.DOMAINS==(\"tuji\",\"uts\")\n    assert \"tampere\" not in g13.DOMAINS\n    assert g13.ROLES==(\"calibration\",\"confirmation\")\n    assert g13.VARIANTS==(\"base\",\"anchor_t06\",\"visibility\",\"strength\",\"joint\")\n    assert (g13.E,g13.L,g13.K)==(5,192,192)\n\n\ndef test_fit_only_detection_and_intensity_are_different_channels():\n    fit,ids,seen=toy_fit()\n    mem=g13.build_fit_observation_memory(fit,ids,2,seen)\n    assert mem[\"fit_rows_per_anchor\"].tolist()==[4.,4.]\n    assert mem[\"model_ap_count\"]==2\n    # First AP always detected at A, absent at B, Beta-shrunk from global.\n    p=mem[\"detection_probability\"]\n    assert 0.<p[1,0]<.5<p[0,0]<1.\n    assert mem[\"conditional_mean\"][0,1] > mem[\"conditional_mean\"][1,1]\n    assert torch.isfinite(mem[\"conditional_variance\"]).all()\n    assert (mem[\"conditional_variance\"]>=g13.SIGMA_FLOOR**2).all()\n\n\ndef test_query_evidence_favors_matching_fit_anchor():\n    fit,ids,seen=toy_fit()\n    mem=g13.build_fit_observation_memory(fit,ids,2,seen)\n    q=torch.tensor([[.21,.115],[-1.,-.425]])\n    anchor=torch.tensor([[0,1],[0,1]])\n    feat=g13.observation_features(q,anchor,seen,mem)\n    assert feat.shape==(2,2,2)\n    assert feat[0,0,0]>feat[0,1,0] # AP detection likelihood\n    assert feat[0,0,1]>feat[0,1,1] # conditional RSS likelihood\n    assert feat[1,1,0]>feat[1,0,0] # AP absence likelihood\n    assert torch.isfinite(feat).all()\n\n\ndef test_observed_negative_one_is_missing_not_strength_measurement():\n    fit,ids,seen=toy_fit()\n    mem=g13.build_fit_observation_memory(fit,ids,2,seen)\n    ap_ids=torch.tensor([[0,1]])\n    q1=torch.tensor([[-1.,-.425]])\n    feature=g13.observation_features(q1,ap_ids,seen,mem)\n    assert torch.isfinite(feature).all()\n    assert feature[0,1,0]>feature[0,0,0]\n\n\ndef test_single_scan_never_collapses_rss_variance_to_zero():\n    fit,ids,seen=toy_fit()\n    one=g13.build_fit_observation_memory(fit[[0,4]],torch.tensor([0,1]),2,seen)\n    assert (one[\"conditional_variance\"]>=g13.SIGMA_FLOOR**2).all()\n    assert torch.isfinite(one[\"conditional_mean\"]).all()\n\n\ndef test_never_overwrite_original_r3_anchors_at_zero_coefficients():\n    torch.manual_seed(14)\n    w=torch.softmax(torch.randn(3,5),dim=1)\n    c=torch.softmax(torch.randn(3,192),dim=1)\n    p=(w[:,:,None]*c[:,None,:]).reshape(3,960)\n    features=torch.randn(3,192,2)\n    pack={\"component_p\":p,\"features\":features}\n    zeros=torch.zeros(2)\n    policies=g13._variant_probabilities(pack,0,3,zeros,torch.device(\"cpu\"))\n    assert torch.equal(policies[\"base\"],p)\n    assert torch.allclose(policies[\"joint\"],policies[\"anchor_t06\"],atol=3e-6)\n    assert torch.allclose(policies[\"visibility\"],policies[\"anchor_t06\"],atol=3e-6)\n    assert torch.allclose(policies[\"strength\"],policies[\"anchor_t06\"],atol=3e-6)\n    for v in policies.values():\n        assert torch.isfinite(v).all()\n        assert torch.allclose(v.sum(1),torch.ones(3),atol=1e-6)\n\n\ndef test_joint_reweighted_law_preserves_original_member_marginal():\n    torch.manual_seed(18)\n    w=torch.softmax(torch.randn(2,5),dim=1)\n    c=torch.softmax(torch.randn(2,192),dim=1)\n    p=(w[:,:,None]*c[:,None,:]).reshape(2,960)\n    pack={\"component_p\":p,\"features\":torch.randn(2,192,2)}\n    q=g13._variant_probabilities(\n        pack,0,2,torch.tensor([.7,.5]),torch.device(\"cpu\"))\n    for variant in g13.VARIANTS:\n        margin=q[variant].reshape(2,5,192).sum(2)\n        assert torch.allclose(margin,w,atol=1e-6)\n\n\ndef test_no_observed_APs_produce_neutral_strength_evidence():\n    fit,ids,seen=toy_fit()\n    mem=g13.build_fit_observation_memory(fit,ids,2,seen)\n    f=g13.observation_features(\n        torch.tensor([[-1.,-1.]]),torch.tensor([[0,1]]),seen,mem)\n    assert torch.allclose(f[0,:,1],torch.zeros(2))\n\n\ndef test_invalid_AP_mapping_and_probability_fail_explicitly():\n    fit,ids,seen=toy_fit()\n    with pytest.raises(g13.G13Error,match=\"invalid FIT\"):\n        g13.build_fit_observation_memory(fit,ids,2,torch.tensor([False,False]))\n    mem=g13.build_fit_observation_memory(fit,ids,2,seen)\n    with pytest.raises(g13.G13Error,match=\"candidate IDs\"):\n        g13.observation_features(fit[[0]],torch.tensor([[0,2]]),seen,mem)\n    with pytest.raises(g13.G13Error,match=\"coefficients\"):\n        g13.probability(torch.ones(1,2)/2,torch.zeros(1,2,2),\n                        torch.tensor([3.,0.]))\n\n\ndef test_training_only_two_coefficients_and_zero_data_leak():\n    torch.manual_seed(9)\n    # Synthetic two-site evidence, original anchor posterior deliberately flat.\n    p={\n        \"c\":torch.tensor([[.5,.5],[.5,.5]]),\n        \"features\":torch.tensor([[[1.,1.],[-1.,-1.]],\n                                 [[-1.,-1.],[1.,1.]]]),\n        \"centres\":torch.tensor([[[0.,0.],[10.,0.]],\n                                [[0.,0.],[10.,0.]]]),\n        \"target\":torch.tensor([[0.,0.],[10.,0.]]),\n        \"gid\":torch.tensor([0,1]),\n        \"sites\":2,\"rows\":2,\n    }\n    fitted=g13.fit({\"tuji\":p,\"uts\":p},\"cpu\")\n    q=fitted[\"coefficients\"]\n    assert 0<=q[\"visibility\"]<=g13.COEFF_CAP\n    assert 0<=q[\"strength\"]<=g13.COEFF_CAP\n    assert len(fitted[\"train_loss_by_epoch\"])==g13.EPOCHS\n    assert fitted[\"no_confirmation_fitting\"] is True\n\n\ndef test_immutable_artifacts_and_one_shot_run_guard(tmp_path,monkeypatch):\n    f=tmp_path/\"a.json\"\n    record=g13._write(f,{\"scientific_status\":\"FIT-only\"})\n    assert g13._read(f)==record\n    with pytest.raises(FileExistsError):g13._write(f,{\"retry\":True})\n    record[\"scientific_status\"]=\"bad\"\n    f.write_text(json.dumps(record),encoding=\"utf-8\")\n    with pytest.raises(g13.G13Error,match=\"hash mismatch\"):g13._read(f)\n    lock=tmp_path/\"already.lock\";lock.write_text(\"yes\")\n    monkeypatch.setattr(g13,\"LOCK\",lock)\n    monkeypatch.setattr(g13,\"RESULT\",tmp_path/\"notresult\")\n    monkeypatch.setattr(g13,\"COEFFICIENTS\",tmp_path/\"notcoeff\")\n    with pytest.raises(g13.G13Error,match=\"already locked\"):\n        g13.run(\"cpu\")\n\n\ndef test_source_does_not_fit_or_evaluate_tampere():\n    s=inspect.getsource(g13)\n    assert 'DOMAINS=(\"tuji\",\"uts\")' in s\n    assert \"g11.map_fit_rows_to_model_anchors\" in s\n    assert 'p[\"rows\"][\"fit\"]' in s\n    assert 'p[\"rows\"][\"calibration\"]' in s\n    assert 'p[\"rows\"][\"confirmation\"]' in s\n    assert \"r3._score_joint_law\" in s\n    assert \"_fit_refit(\" not in s\n    assert \"train_member(\" not in s\n    assert \"load_tampere(\" not in s\n    assert \"load_uts(\\\"test\\\")\" not in s\n    assert \"g8.RESULT\" not in s\n    assert \"g10.RESULT\" not in s\n"}, "fhm_dapp_tim/evidence/v17_g13_multiscan_observation/DESIGN_V17_G13.md": {"sha256": "9aa6b8acae6ef4c3a8b63133049c9120797c14de2a238ee0bef73c9a953b96b8", "text": "# G13 — FIT multi-scan AP visibility and conditional RSS evidence\n\n**Preregistered before any G13 outcomes, 2026-10-12.**\n\n## Scientific goal and dataset scope\n\nG8–G9 established that original V17 E5 error reduction mainly comes from shared anchor probability sharpening, while correct-neighbourhood anchors are typically retained. G10's four-parameter generic evidence correction yielded modest gains. G11 showed raw RSS contains useful but not uniformly better signals, and G12 showed that changing point action can help TUJI yet harm UTS. G13 tests a *physically interpretable observation model*: independently quantify AP detection and RSS intensity conditional on AP detection using **repeated FIT scans at each physical anchor**. No new E5 neural model training and no global T grid.\n\nG13 evaluates **TUJI and UTS only**. Tampere is excluded from new experiments, all decision gates, and reported primary tables because its one-scan-per-reference acquisition does not match this study's multi-scan aim. Do not delete historical evidence. UJIIndoorLoc remains part of the final target family but needs its own compatible FIT-trained model and unviewed evaluation protocol; we shall NOT fabricate a UJI E5 checkpoint or access official UJI test data in G13.\n\nThe original TUJI G6 and UTS G4 five-member checkpoints, physical FIT/CAL/CONFIRM splits and model-seen AP masking are immutable; original checkpoints must match their historic SHA256. All previously analysed CAL/CONFIRM labels are **retrospective**, not independent blind validation.\n\n## FIT-only observation statistics\n\nMap each FIT RSS row to the exact original E5 anchor ID using G11's verified building/floor/XY bijection. For anchor a and AP l with FIT scan count n_a and detected count d_al:\n\nDetection probability pi_al = (d_al + kappa * pi_global_l)/(n_a + kappa).\n\npi_global_l is FIT-wide Beta(0.5,0.5)-smoothed detection frequency; kappa=4 pseudo scans. Detect only normalized model RSS > -0.999, the original G11 rule. A model RSS exactly -1 cannot distinguish true missing from clipped -110 dBm, so report this limitation honestly. Do not treat absence as an observed weak RSS value.\n\nFor detected RSS only, derive global conditional AP means/variances from FIT; estimate anchor-specific means and conditional variances with kappa=4 global pseudo observations. Minimum conditional normalized RSS standard deviation is 0.06. The conditional strength uses fixed Student-t degrees of freedom 4. This is a robust **composite** likelihood under simplifying AP independence, not a proven physical joint RSS density. Report actual FIT scans per anchor, especially sites with only one observation; do not assume all site counts are large or scans independent.\n\nFor each original R3 Top-K=192 selected anchor ID compute two label-free query scores: averaged log Bernoulli AP detection/absence evidence and averaged log Student-t RSS evidence for detected APs. Each score is centred across K candidates with variance stabilization sqrt(candidate_variance + 0.2 squared), so absence of real discrimination is not artificially magnified. Never use query true XY/building/floor or a post-hoc correct-neighbourhood indicator as an inference feature.\n\n## One tiny trainable calibration, no grid search\n\nPreserve R3 E5/L192/K192/alpha1 component centres, Student-t df4 scales and original member probabilities. Strong original anchor-only T=0.6 is the fixed comparator. Apply two nonnegative scalar evidence coefficients in [0,1.5], initialized exactly zero:\n\nqtheta(a|r) = softmax(log(original_consensus_c_a)/0.6 + theta_v * z_v + theta_s * z_s).\n\nFit **once** using ORIGINAL TUJI G6 CAL and UTS G4 CAL physical locations, equal sites within domain and equal domain contribution; Adam lr 0.05, 24 epochs, batch24, seed20261012, no early stopping or hyperparameter selection. The loss is G10's pre-existing Dirac-mixture Energy Score at member-averaged centres + 0.3 Euclidean point MAE, divided by 10m, plus 0.1 KL(qtheta || anchor T=.6). It is a **surrogate**, NOT the full continuous Student-t ES used at assessment. Freeze both coefficients before extracting or scoring any CONFIRM rows.\n\nAt historical CONFIRM compare exactly five policies: base original R3; strong anchor_t06; visibility-only fitted coefficient; strength-only fitted coefficient; joint. Both one-feature policies use the coefficients from the **same** joint fit; no re-fit. Score full continuous Student-t Energy Score with G8 common-random-number stream seed19602, 64+64 draws, physical-coordinate macro MAE, ES, P90, P95, worst location and paired site harm counts. Single primary descriptive contrast is joint minus strong anchor_t06 on TUJI and UTS. Require at least 0.15m MAE gain and ES nonworsening in **each** domain to register a descriptive encouraging signal. This screen is NOT a 95% test, prospectively independent promotion or publication claim; all evaluated labels were previously explored.\n\n## Scientific safeguards\n\nNo model training on original FIT for the new coefficients beyond FIT-only likelihood statistics; no CONFIRM leakage into fitting; no provided/official test, no Tampere. Numeric identities check the original R3 member-anchor law, candidate ID alignment and zero-evidence equivalence to original Anchor T=.6. One run lock is created before learning coefficients; immutable coefficient record written before CONFIRM inference; no deleting lock/retrying after failure. Correct implementation bugs only prior to plan freeze, never modify old G4–G12 scientific files or experiments. User handles Git commands; Codex never runs them.\n\nIf G13 does not consistently beat Anchor T=.6, stop this simple conditional-independence evidence model rather than inflate complexity. If useful, build a physically disjoint future UJIIndoorLoc experiment with E5/E16/E25 competitive absolute MAE, full proper ES and adverse tail evaluation; only there investigate AP correlations, session/device effects and principled density-ratio or contrastive learning. JCR Q1 novelty must come from a well-supported multi-scan observation-model contribution, not rebranding common statistical components.\n"}, "V17_G13_CODEX_RUN.txt": {"sha256": "3b0da889d2d8b3c79f37424c7c96b8a0931ef85b154ef48ad8f4781717e754a8", "text": "V17-G13 | Codex scientific run: multi-scan AP-detection + conditional RSS evidence\n========================================================================\nBRANCH: v17-g13-multiscan-observation-evidence-pilot\nSCIENTIFIC CODE:\n fhm_dapp_tim/fhm_dapp/uji_v17_g13_multiscan_observation.py\nDESIGN:\n fhm_dapp_tim/evidence/v17_g13_multiscan_observation/DESIGN_V17_G13.md\nTEST:\n tests/test_uji_v17_g13_multiscan_observation.py\n\n研究目的：验证多扫描 RSS 指纹是否允许从 FIT 估计 AP 检测概率和\n条件 RSS 强度，再为 V17 的空间候选提供额外观测证据。不是继续\n搜索温度、不是 G10 的四特征后验修补，也不训练新 V17 网络。\n\n【本轮研究范围】\n只使用 TUJI G6、UTS G4 原始冻结五成员权重与训练文件内部\nFIT/CAL/CONFIRM 物理位置划分。Tampere 从本轮及未来主模型评价排除，\n不要删除任何历史 Tampere 结果。UJIIndoorLoc (UJII) 是最终目标\n数据集，但本轮没有同协议新的独立 E5 检查点；严禁伪造 UJI 结果。\n后续另行设计 UJI 的独立多扫描物理位置隔离及官方测试协议。\nG10-G12 只作机制参考，不用其 CONFIRM 标签调整 G13。\n\n【与前面 G8-G12 区别】\n原 E5 / L192 / K192 / alpha1 / Student-t df4 的 FIT 参考点、\n所有冻结成员权重、连续分量中心与尺度完全不变。\n观测似然从原 FIT 多次扫描估计：\n1. P(AP detected | anchor) 使用 Beta(.5,.5) 全域 FIT 参考概率、\n   各锚点计数向全局收缩4次伪观测；\n2. P(RSS strength | AP detected,anchor) 只使用检测到 AP 的 RSS，\n   全域 FIT 条件均值/方差收缩4伪观测，Student-t df4 评分，\n   模型归一化 RSS 最小 sigma=.06。\n模型 RSS==-1 被视为缺失/地板裁剪；不能区分这两种原始事件。\n只处理模型原 seen_AP mask 的列。真实 query 楼层/建筑/XY、\n真实错误大小、邻近正确标签绝不进入部署特征。FIT 锚点\n身份必须经原 G11 物理坐标+楼层匹配的一一映射验证。\n\n【仅两个共享参数，只有一次学习】\n原 c 的强基线为 Anchor T=.6。两个经每query候选内稳健\n标准化的可见性与RSS证据，分别乘以非负系数 θv,θs∈[0,1.5]。\n两个系数从0开始，Adam lr=.05，固定24 epochs，batch24，\n随机种子20261012。原 TUJI CAL、UTS CAL 每个物理位置等权，\n两个数据域等权。原 FIT 只用于不带标签学习的扫描统计，\n任何 CONFIRM 不进入系数拟合、损失、epoch挑选或候选选择。\nCAL损失采用原 G10 的连续中心 Dirac-mixture Energy Score\n代理 +0.30*点MAE、缩放10m、+0.10 KL(新||强基线)。\n此 TRAIN 损失不是连续 Student-t ES；不要混淆。\n\n【唯一冻结的五个评价方案】\nbase: 原 R3\nanchor_t06: 原始全域固定强基线，T=.6\nvisibility: 同一次联合训练得到的 θv，θs=0（不重新训练）\nstrength: 同一次联合训练得到的 θs，θv=0（不重新训练）\njoint: 原来一次训练得到的 θv 和 θs 都使用\n共享原 R3 连续分布、MC 两流各64次、原 G8 seed19602。\n评价 TUJI和UTS 的历史 CONFIRM，物理位置宏 MAE、真实连续\nEnergy Score、P90/P95、最差坐标、逐坐标负迁移数和配对向量。\n主要比较 joint 相对 anchor_t06；不因为另外两条消融较好\n就事后改主候选。描述性正向信号须TUJI与UTS各自 MAE 至少\n改善0.15m且ES不恶化。因历史确认角色早已被看到，这绝非\n独立显著性或正式晋级；如果不达标就保留失败，不调参再试。\n\n【用户本地 CUDA / Codex 执行顺序】\n在仓库根目录、以前成功运行 V17 的 Python 环境：\npython -m compileall -q fhm_dapp_tim/fhm_dapp/uji_v17_g13_multiscan_observation.py tests/test_uji_v17_g13_multiscan_observation.py\npython -m pytest -q tests/test_uji_v17_g13_multiscan_observation.py tests/test_uji_v17_g11_rss_identifiability.py\npython -m fhm_dapp_tim.fhm_dapp.uji_v17_g13_multiscan_observation preflight\n\n先验证原 G6 TUJI、G4 UTS 五成员所有 checkpoint SHA256、\n原 FIT/CAL/CONFIRM 物理位置、数据与 AP schema。\n确认每个 anchor 实际扫描次数统计，且绝不读取 official/\nprovided test（TUJI MAT 只能解出results_train变量）。\n如果缺失旧权重或者原源码hash不匹配，STOP，禁止重训冒充。\n\n仅允许在 prepare 之前修复经CPU测试重现的新 G13 科学 bug；\n重新完整测试。严禁修改任何 G1-G12 旧科学源码或实验证据，\n不能为了结果好看修改缺失AP阈值、伪观测数、训练损失或系数范围。\n\n全部通过后：\npython -m fhm_dapp_tim.fhm_dapp.uji_v17_g13_multiscan_observation prepare\npython -m fhm_dapp_tim.fhm_dapp.uji_v17_g13_multiscan_observation check\npython -m fhm_dapp_tim.fhm_dapp.uji_v17_g13_multiscan_observation run --device cuda\npython -m fhm_dapp_tim.fhm_dapp.uji_v17_g13_multiscan_observation check\n\nrun 必须先写不可逆 lock，随后提取 CAL、学习恰好两个系数、\n先将系数保存为冻结 JSON，最后才读取 CONFIRM 做配对评价。\n任何 lock 后故障，都保留 lock 与错误日志立即 STOP；不允许\n删除锁重跑或根据确认集迭代超参数。\n\n【精简产物】\nfhm_dapp_tim/evidence/v17_g13_multiscan_observation/\n DESIGN_V17_G13.md\n manifest_v17_g13.json\n pilot_v17_g13.lock\n coefficients_v17_g13.json\n evaluation_v17_g13.json\n RUN_REPORT_V17_G13.md\n RUN_NOTES.md（仅一页：测试 exit code、GPU、原始 E5 hash、\n              FIT 扫描次数、是否发生修复、是否保持历史文件不变）\n无须几十份审计产物，无须上传 .pt。\n\n【跑完之后】\nChatGPT独立检查原始FIT重复扫描强度、两个新系数、VIS/RSS联合\n消融、同预算绝对 MAE/ES、空间尾部风险与不利样本。根据真实\n机制决定是否发展空间判别型观测证据模型，不能因Q1目标强行\n认定学习的参数或跨领域迁移本身已经足够创新。\n不把历史确认集写成新盲测；UJI 等待严格独立协议。\n\nGit 操作由用户自行执行。Codex不执行任何 Git 命令。\n"}}, "environment": {"python": "3.12.12 | packaged by Anaconda, Inc. | (main, Oct 21 2025, 20:05:38) [MSC v.1929 64 bit (AMD64)]", "python_executable": "D:\\miniminiconda\\envs\\liuyan\\python.exe", "platform": "Windows-10-10.0.19045-SP0", "torch": "2.10.0+cu128", "cuda_runtime": "12.8", "numpy": "2.4.4", "scipy": "1.17.1", "cuda_available": true, "device": "NVIDIA GeForce RTX 2060", "device_bytes": 6442123264}}

