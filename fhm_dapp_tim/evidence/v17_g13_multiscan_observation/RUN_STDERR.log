STAGE_RECORD {"stage": "fit-only-observation-and-cuda-check", "started_at": "2026-10-12T13:39:25.196832+08:00", "seconds": 13.364263299998129, "command": ["D:\\miniminiconda\\envs\\liuyan\\python.exe", "-"], "helper_code": "import collections, hashlib, itertools, json, pathlib, sys\nimport numpy as np, torch\nfrom fhm_dapp_tim.fhm_dapp import uji_v17_g13_multiscan_observation as g13\nroot=pathlib.Path.cwd()\nassert not g13.MANIFEST.exists() and not g13.LOCK.exists()\nallowed={str((root/p).resolve()).casefold() for p in [\"data/UTSIndoorLoc/UTS_training.csv\",*[f\"data/TUJI1/Formatted_data_{n}.mat\" for n in (\"A12\",\"POCO\",\"S20\",\"S7\",\"tabS7\")]]}\nopened=set()\ndef guard(event,args):\n    if event!=\"open\" or not isinstance(args[0],(str,bytes,pathlib.Path)):return\n    p=pathlib.Path(args[0]).resolve()\n    if p.is_relative_to(root/\"data\"):\n        name=str(p).casefold()\n        if name not in allowed:raise RuntimeError(f\"Forbidden dataset access: {p}\")\n        opened.add(p.relative_to(root).as_posix())\n    rel=p.relative_to(root).as_posix() if p.is_relative_to(root) else \"\"\n    if p.suffix==\".json\" and any(f\"/v17_g{i}_\" in rel for i in (10,11,12)):\n        raise RuntimeError(\"Old G10-G12 score JSON access is forbidden in pre-freeze smoke\")\nsys.addaudithook(guard)\nmat_calls=[]\noriginal_mat=g13.g8.g6.loadmat\ndef limited_mat(*args,**kwargs):\n    assert tuple(kwargs.get(\"variable_names\",()))==(\"results_train\",)\n    data=original_mat(*args,**kwargs)\n    assert \"results_train\" in data and \"results_test\" not in data\n    mat_calls.append({\"file\":pathlib.Path(args[0]).name,\"variables\":list(kwargs[\"variable_names\"]),\"results_test_returned\":False})\n    return data\ng13.g8.g6.loadmat=limited_mat\noriginal_optimizer=torch.optim.Optimizer.__init__\ndef no_optimizer(*args,**kwargs):raise AssertionError(\"No optimizer in FIT-only compatibility check\")\ntorch.optim.Optimizer.__init__=no_optimizer\ndef tensor_hash(t):return hashlib.sha256(t.detach().cpu().contiguous().numpy().tobytes()).hexdigest()\nresult={}\nfor domain in g13.DOMAINS:\n    p=g13._pack(domain)\n    assert all(not p[\"groups\"][a]&p[\"groups\"][b] for a,b in itertools.combinations((\"fit\",\"calibration\",\"confirmation\"),2))\n    models,origin=g13.g8._load_models(domain,{\"model_and_role_provenance\":{domain:p[\"original\"]}},\"cuda\")\n    ref=models[0];seen=ref.encoder.seen_ap_mask.detach().cpu().bool()\n    assert torch.equal(seen,(ref.prototype_rss.detach().cpu()>-.999).any(0))\n    for model in models:\n        assert not model.training\n        for attr in (\"anchor_coords\",\"anchor_buildings\",\"anchor_floors\",\"prototype_rss\"):\n            assert torch.equal(getattr(model,attr),getattr(ref,attr))\n        assert torch.equal(model.encoder.seen_ap_mask,ref.encoder.seen_ap_mask)\n    state=[{k:v.detach().cpu().clone() for k,v in m.state_dict().items()} for m in models]\n    fit_rows=p[\"rows\"][\"fit\"]\n    ids,keys=g13.g11.map_fit_rows_to_model_anchors(fit_rows,p[\"data\"],ref,origin)\n    count=int(ref.n_anchors)\n    assert count>=192 and len(keys)==count and len(torch.unique(ids))==count\n    fit_rss=p[\"data\"][\"rss\"][fit_rows]\n    memory=g13.build_fit_observation_memory(fit_rss,ids,count,seen)\n    x=fit_rss[:,seen].double().numpy()\n    idx=ids.numpy()\n    z=(x>-.999).astype(np.float64)\n    counts=np.bincount(idx,minlength=count).astype(np.float64)\n    d=np.zeros((count,len(seen.nonzero())))\n    sx=np.zeros_like(d);ss=np.zeros_like(d)\n    np.add.at(d,idx,z);np.add.at(sx,idx,x*z);np.add.at(ss,idx,x*x*z)\n    gv=(z.sum(0)+.5)/(len(x)+1.)\n    pi=np.clip((d+4.*gv)/(counts[:,None]+4.),1e-5,1-1e-5)\n    nd=z.sum(0)\n    gm=(x*z).sum(0)/np.maximum(nd,1)\n    vv=np.maximum((x*x*z).sum(0)/np.maximum(nd,1)-gm*gm,.06**2)\n    mu=(sx+4.*gm)/(d+4.)\n    var=np.clip((ss-2*mu*sx+mu*mu*d+4*(vv+(gm-mu)**2))/(d+4.),.06**2,1.)\n    formula={}\n    for name,expected in ((\"detection_probability\",pi),(\"conditional_mean\",mu),(\"conditional_variance\",var)):\n        actual=memory[name].double().numpy()\n        assert np.allclose(actual,expected,rtol=3e-6,atol=3e-6),(domain,name,float(np.abs(actual-expected).max()))\n        formula[name]=float(np.abs(actual-expected).max())\n    assert np.array_equal(counts,memory[\"fit_rows_per_anchor\"].numpy())\n    rows=fit_rows[:12]\n    torch.cuda.reset_peak_memory_stats()\n    with torch.no_grad():\n        packed=g13.extract(models,p[\"data\"],rows,origin,memory,scoring=True)\n        policies=g13._variant_probabilities(packed,0,len(rows),torch.zeros(2,device=\"cuda\"),torch.device(\"cuda\"))\n        for name in (\"joint\",\"visibility\",\"strength\"):\n            assert torch.equal(policies[name],policies[\"anchor_t06\"]), \"zero evidence must exactly recover Anchor T0.6\"\n        assert torch.equal(policies[\"base\"].cpu(),packed[\"component_p\"])\n        assert packed[\"features\"].shape==(len(rows),192,2)\n        assert torch.allclose(packed[\"features\"].mean(1),torch.zeros(len(rows),2),atol=2e-5)\n        scored=g13.score(packed,[0.,0.],\"cuda\")\n        for name in (\"joint\",\"visibility\",\"strength\"):\n            for metric in (\"site_mae_m\",\"site_ES_m\"):\n                assert scored[\"methods\"][name][metric]==scored[\"methods\"][\"anchor_t06\"][metric]\n    for model,before in zip(models,state):\n        assert all(torch.equal(v.detach().cpu(),before[k]) for k,v in model.state_dict().items())\n        assert all(v.grad is None for v in model.parameters())\n    hist={int(k):int(v) for k,v in sorted(collections.Counter(counts.astype(int)).items())}\n    result[domain]={\"roles\":{r:{\"rows\":len(p[\"rows\"][r]),\"sites\":len(p[\"groups\"][r]),\"keys_sha256\":g13._canonical_json_sha256([list(k) for k in sorted(p[\"groups\"][r])])} for r in (\"fit\",\"calibration\",\"confirmation\")},\"role_intersections_zero\":True,\"checkpoint_sha256\":p[\"original\"][\"checkpoints\"],\"ap_width\":int(fit_rss.shape[1]),\"seen_AP_count\":int(seen.sum()),\"seen_AP_column_indices_sha256\":tensor_hash(torch.where(seen)[0]),\"seen_AP_mask_shared\":True,\"original_prototype_RSS_sha256\":tensor_hash(ref.prototype_rss),\"anchor_bijection_verified\":True,\"fit_scans_per_anchor\":{\"sites\":count,\"rows\":len(fit_rows),\"min\":int(counts.min()),\"median\":float(np.median(counts)),\"mean\":float(counts.mean()),\"max\":int(counts.max()),\"histogram\":hist},\"independent_numpy_formula_max_abs_error\":formula,\"fit_only_smoke_rows\":len(rows),\"zero_evidence_probabilities_MAE_ES_bitwise_identical\":True,\"model_state_unchanged_and_grads_none\":True,\"smoke_cuda_peak_bytes\":torch.cuda.max_memory_allocated(),\"origin_xy\":origin.tolist()}\n    del models,ref,state,packed,policies,scored,memory\n    torch.cuda.empty_cache()\nassert len(opened)==6\nassert len(mat_calls)==5\nprint(json.dumps({\"status\":\"FIT_ONLY_OBSERVATION_AND_CUDA_CHECK_PASSED\",\"domains\":result,\"dataset_files_opened\":sorted(opened),\"TUJI_variable_calls\":mat_calls,\"optimizer_created\":False,\"old_G10_G12_result_JSON_accessed\":False,\"warning\":\"Physical TUJI MAT containers were opened and hashed; only results_train decoded. FIT repeats are not assumed independent.\"},ensure_ascii=False,allow_nan=False))\n", "exit_code": 0, "stdout_sha256": "59fb09a6cab4f17b808fd2846b21378315bf55dcc72232d8aba576e2eb6ddb8f", "stderr_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"}

END_STAGE fit-only-observation-and-cuda-check

