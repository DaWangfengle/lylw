STAGE_RECORD {"stage": "read-only-check-failure-audit", "started_at": "2026-10-12T13:45:32.070999+08:00", "seconds": 4.529503800004022, "command": ["D:\\miniminiconda\\envs\\liuyan\\python.exe", "-"], "helper_code": "import copy, datetime, difflib, hashlib, json, pathlib\nimport numpy as np\nfrom fhm_dapp_tim.fhm_dapp import uji_v17_g13_multiscan_observation as g13\nroot=pathlib.Path.cwd();out=g13.OUT\nbaseline=json.loads((out/\"RUN_STDOUT.log\").read_text(encoding=\"utf-8\").splitlines()[0].split(\" \",1)[1])\ndef sha(p):\n    h=hashlib.sha256()\n    with p.open(\"rb\") as f:\n        for block in iter(lambda:f.read(1048576),b\"\"):h.update(block)\n    return h.hexdigest()\nassert all(sha(root/p)==v for p,v in baseline[\"protected_files\"].items())\nassert all(sha(root/p)==v for p,v in baseline[\"original_model_sha256\"].items())\nassert all(sha(root/p)==v[\"sha256\"] for p,v in baseline[\"G13_original_sources\"].items())\nmanifest=g13._read(g13.MANIFEST,\"manifest_sha256\")\nlock=g13._read(g13.LOCK)\ncoeff=g13._read(g13.COEFFICIENTS)\nresult=g13._read(g13.RESULT)\nassert manifest[\"source_sha256\"]==g13._source_hashes()\nassert lock[\"manifest_file_sha256\"]==sha(g13.MANIFEST)\nassert coeff[\"manifest_file_sha256\"]==sha(g13.MANIFEST)\nassert coeff[\"lock_file_sha256\"]==sha(g13.LOCK)\nassert result[\"manifest_file_sha256\"]==sha(g13.MANIFEST)\nassert result[\"lock_file_sha256\"]==sha(g13.LOCK)\nassert result[\"coefficients_file_sha256\"]==sha(g13.COEFFICIENTS)\nassert result[\"coefficients\"]==coeff\nassert coeff[\"epochs\"]==24 and len(coeff[\"train_loss_by_epoch\"])==24\nassert all(np.isfinite(v) for v in coeff[\"train_loss_by_epoch\"])\nassert all(0<=v<=1.5 for v in coeff[\"coefficients\"].values())\nobserved=g13.REPORT.read_text(encoding=\"utf-8\")\nreplayed=g13._report(result)\ndifferent=[{\"line\":i+1,\"recorded\":a,\"replayed\":b} for i,(a,b) in enumerate(zip(observed.splitlines(),replayed.splitlines())) if a!=b]\nassert len(observed.splitlines())==len(replayed.splitlines()) and len(different)==1,different\nassert \"learned coefficients:\" in different[0][\"recorded\"]\ncanonical=copy.deepcopy(result)\nc=canonical[\"coefficients\"][\"coefficients\"]\ncanonical[\"coefficients\"][\"coefficients\"]={\"visibility\":c[\"visibility\"],\"strength\":c[\"strength\"]}\nassert g13._report(canonical)==observed\nassert g13._canonical_json_sha256(canonical,omit=\"result_sha256\")==result[\"result_sha256\"]\nsynthetic=[]\nfor values in ((0.,0.),(.3,.7),(1.5,1.5)):\n    for order in ((\"visibility\",\"strength\"),(\"strength\",\"visibility\")):\n        cc={key:dict(zip((\"visibility\",\"strength\"),values))[key] for key in order}\n        fixed={key:cc[key] for key in (\"visibility\",\"strength\")}\n        normalized=json.loads(json.dumps(cc,sort_keys=True))\n        fixed_after={key:normalized[key] for key in (\"visibility\",\"strength\")}\n        assert repr(fixed)==repr(fixed_after)\n        synthetic.append({\"values\":list(values),\"incoming_order\":list(order),\"fixed_display_stable\":True})\nreviews={}\nfor domain in g13.DOMAINS:\n    p=result[\"confirm\"][domain]\n    keys=p[\"physical_coordinate_keys\"];n=p[\"physical_sites\"]\n    assert len(keys)==n and sorted(keys)==keys and len({tuple(k) for k in keys})==n\n    assert keys==manifest[\"original_E5_panel_provenance\"][domain][\"role_coordinate_keys\"][\"confirmation\"]\n    assert n=={\"tuji\":139,\"uts\":263}[domain] and p[\"rows\"]=={\"tuji\":701,\"uts\":1692}[domain]\n    methods=p[\"methods\"]\n    assert set(methods)==set(g13.VARIANTS)\n    for name,v in methods.items():\n        ma=np.asarray(v[\"site_mae_m\"]);es=np.asarray(v[\"site_ES_m\"])\n        assert ma.shape==es.shape==(n,) and np.isfinite(ma).all() and np.isfinite(es).all()\n        assert (ma>=0).all()\n        for got,want in ((v[\"macro_mae_m\"],ma.mean()),(v[\"macro_ES_m\"],es.mean()),(v[\"p90_site_mae_m\"],np.quantile(ma,.9)),(v[\"p95_site_mae_m\"],np.quantile(ma,.95)),(v[\"worst_site_mae_m\"],ma.m